  <!-- =====================================================================
       SCRIPTS
       ===================================================================== -->
  <script>
    (function () {
      'use strict';

      /* ---------------- LANGUAGE TOGGLE (EN default) ---------------- */
      var htmlEl = document.documentElement;
      function setLang(lang) {
        var isEs = lang === 'es';
        htmlEl.classList.toggle('lang-mode-es', isEs);
        htmlEl.classList.toggle('lang-mode-en', !isEs);
        htmlEl.setAttribute('lang', isEs ? 'es' : 'en');
        document.querySelectorAll('.lang-pill button').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-lang') === lang));
        });
      }
      document.querySelectorAll('.lang-pill button').forEach(function (btn) {
        btn.addEventListener('click', function () { setLang(btn.getAttribute('data-lang')); });
      });

      /* ---------------- PRODUCT CARD -> jump to form + preselect ---------------- */
      document.querySelectorAll('.pcta').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var prod = btn.getAttribute('data-product');
          var sel = document.getElementById('m-product');
          if (sel && prod) sel.value = prod;
          var target = document.getElementById('quote-form');
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          var nameField = document.getElementById('m-name');
          if (nameField) setTimeout(function () { nameField.focus({ preventScroll: true }); }, 500);
        });
      });

      /* Forms POST natively to Shopify's contact handler (Shopify Liquid contact form).
         On the success re-render, each form's posted_successfully? block dispatches
         png:quote_request_submitted, which png-tracking-pixels maps to Meta Lead +
         Google Ads conversion. No client-side submit interception needed here. */
    })();
  </script>

  {%- comment -%} Pixels load from png-tracking-pixels (head). Conversion fires via the
     png:quote_request_submitted event dispatched on form success. {%- endcomment -%}

