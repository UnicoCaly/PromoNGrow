{% layout none %}
<!doctype html>
<!--
  ============================================================================
  PROMO & GROW — Free-Proof Quote Landing Page · Shopify template (page.lp-free-proof)
  Renders standalone via the layout-none tag above (no Dawn chrome). Forms use Shopify's
  native contact form -> store contact email. Tracking via png-tracking-pixels: on submit
  success we dispatch png:quote_request_submitted (pixel bridge -> Meta Lead + Google Ads).
  ----------------------------------------------------------------------------
  PROMO & GROW — V10 "THE PROOF DROP" — Free-Proof Quote LP v2 (template page.lp-free-proof-v2)
  V2: upload-first hero (drag-drop -> png-logo-upload.carlos-154.workers.dev -> contact[Logo file]),
  two-step modal form, client-logo marquee, packages pricing (#pricing), scroll-reveal.
  Single self-contained file. Serves BOTH campaigns:
    1) OUTBOUND (Venus cold-calls / IG+WhatsApp DMs / segment cold-email)
    2) PPC (lean Google Search + Meta UGC -> WhatsApp)
  The conversion event for BOTH = a quote-form submit (quote_request_submitted).
  ----------------------------------------------------------------------------
  TRACKING IS STUBBED BY DEFAULT (TRACKING_ENABLED = false) so test submits do
  NOT pollute live Google Ads / Meta conversion data. To go live:
    1) set TRACKING_ENABLED = true (bottom of file)
    2) paste the gtag base snippet + the fbq base snippet (also at bottom)
  Real IDs are wired in, guarded behind the flag:
    - Google Ads: AW-17631020505 / label _S8lCJKl6sIcENmLkNdB (quote_request_submitted)
    - Meta Pixel: 1205589804645510 (Lead)
  ----------------------------------------------------------------------------
  BILINGUAL: every string ships in BOTH languages as matching .lang-en /
  .lang-es spans. A vanilla-JS toggle sets a class on <html> (default: EN).
  IMAGES: no external image assets exist — premium navy/copper placeholder
  treatments with "[ real booth photo -- swap in ]" captions, never stock.
  ANTI-BRAND GUARDRAILS BAKED IN: no "guaranteed", no countdowns / fake urgency,
  Donut told as "fast" with NO production day-count, nothing cheap-looking.
  ============================================================================
-->
{%- assign lp_lang = 'en' -%}
{%- if page.handle == 'prueba-gratis' -%}{%- assign lp_lang = 'es' -%}{%- endif -%}
<html lang="{{ lp_lang }}" class="lang-mode-{{ lp_lang }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  {%- if lp_lang == 'es' -%}
  <title>Prueba Gratis — Promo &amp; Grow | Displays Personalizados para Eventos, Hechos en LA</title>
  <meta name="description" content="Mándanos tu logo y recibe una prueba gratis — tu marca en tu carpa, mantel, bandera o backdrop — antes de pagar nada. La apruebas y lo tienes listo en 5 días hábiles. Hecho en LA, más de 20 años de experiencia, en español." />
  {%- else -%}
  <title>Get a Free Proof — Promo &amp; Grow | Custom Event Displays Made in LA</title>
  <meta name="description" content="Send us your logo and get a free proof — your brand on your tent, table cover, flag, or backdrop — before you pay a cent. Approve it and you're booth-ready in 5 business days. Made in LA, 20+ years, bilingual." />
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=DM+Sans:ital,wght@0,400;0,500;0,700;1,400&display=swap" rel="stylesheet" />

  {%- comment -%} Shopify head injection (required under layout none) + live Meta/Google pixels {%- endcomment -%}
  {{ content_for_header }}
  {%- render 'png-tracking-pixels' -%}

  <style>
    @font-face {
      font-family: 'Cooper Black';
      src: url('{{ "cooper-black.woff2" | asset_url }}') format('woff2');
      font-weight: normal; font-style: normal; font-display: swap;
    }

    :root {
      /* ---- Brand tokens ---- */
      --navy: #1B2838;
      --copper: #C17A3A;
      --copper-dark: #A8682F;
      --green: #1E6B4A;
      --white: #FFFFFF;
      --offwhite: #F7F7F5;
      --slate: #2E3E50;
      --text-secondary: #6C757D;
      --text-muted: #999999;
      --border: #EEEEEE;

      --maxw: 1120px;
      --radius: 8px;
      --shadow-sm: 0 1px 3px rgba(27,40,56,.06);
      --shadow-md: 0 6px 18px rgba(27,40,56,.08);
      --shadow-lg: 0 10px 30px rgba(27,40,56,.10);
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }

    body {
      margin: 0;
      background: var(--white);
      color: var(--navy);
      font-family: "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      font-size: 17px;
      line-height: 1.62;
      -webkit-font-smoothing: antialiased;
      text-rendering: optimizeLegibility;
    }

    h1, h2, h3, h4 {
      font-family: "Cooper Black", "DM Serif Display", Georgia, serif;
      font-weight: normal;
      color: var(--navy);
      line-height: 1.12;
      margin: 0 0 .5em;
      letter-spacing: -0.2px;
    }

    p { margin: 0 0 1em; }
    a { color: var(--copper); text-decoration: none; }
    a:hover { color: var(--copper-dark); text-decoration: underline; }

    img { max-width: 100%; display: block; }

    /* ---- Accessibility: visible focus everywhere ---- */
    a:focus-visible,
    button:focus-visible,
    input:focus-visible,
    select:focus-visible,
    textarea:focus-visible,
    [tabindex]:focus-visible {
      outline: 3px solid var(--copper);
      outline-offset: 2px;
      border-radius: 4px;
    }

    .skip-link {
      position: absolute;
      left: -9999px;
      top: 0;
      background: var(--navy);
      color: var(--white);
      padding: 12px 18px;
      border-radius: 0 0 8px 0;
      z-index: 200;
    }
    .skip-link:focus { left: 0; color: var(--white); text-decoration: none; }

    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    /* ---- Layout ---- */
    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
    .wrap-narrow { max-width: 800px; margin: 0 auto; padding: 0 24px; }
    section { padding: 68px 0; }
    .bg-offwhite { background: var(--offwhite); }
    .bg-navy { background: var(--navy); }

    .eyebrow {
      font-family: "DM Sans", sans-serif;
      font-weight: 500;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--copper);
      margin: 0 0 14px;
    }
    .eyebrow.muted { color: var(--text-secondary); }

    /* =====================================================================
       BILINGUAL TOGGLE — show only the active language
       ===================================================================== */
    .lang-es { display: none; }
    html.lang-mode-es .lang-en { display: none; }
    html.lang-mode-es .lang-es { display: inline; }
    /* block-level bilingual blocks */
    .lang-en.block, .lang-es.block { display: none; }
    html.lang-mode-en .lang-en.block { display: block; }
    html.lang-mode-es .lang-es.block { display: block; }
    html.lang-mode-en a.btn.lang-en.block { display: flex; }
    html.lang-mode-es a.btn.lang-es.block { display: flex; }

    /* =====================================================================
       BUTTONS  (copper = clickable only)
       ===================================================================== */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--copper);
      color: var(--white);
      font-family: "DM Sans", sans-serif;
      font-weight: 500;
      font-size: 13px;
      line-height: 1.2;
      padding: 12px 28px;
      border-radius: 5px;
      border: none;
      cursor: pointer;
      text-align: center;
      transition: background .2s ease;
    }
    .btn:hover { background: var(--copper-dark); color: var(--white); text-decoration: none; }
    .btn-block { display: flex; width: 100%; }
    .btn-lg { font-size: 14px; padding: 14px 32px; }

    .btn-ghost {
      background: transparent;
      color: var(--navy);
      border: 1.5px solid var(--border);
      box-shadow: none;
      font-weight: 500;
    }
    .btn-ghost:hover { background: var(--offwhite); color: var(--navy); border-color: #DcDcDc; box-shadow: none; }

    .btn-on-navy { background: var(--copper); color: var(--white); }
    .btn-on-navy:hover { background: var(--copper-dark); }

    /* =====================================================================
       STICKY HEADER
       ===================================================================== */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 100;
      background: rgba(255,255,255,.96);
      backdrop-filter: saturate(180%) blur(8px);
      border-bottom: 1px solid var(--border);
    }
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 12px 24px;
      max-width: var(--maxw);
      margin: 0 auto;
    }
    .wordmark {
      display: inline-flex;
      align-items: center;
      line-height: 0;
      text-decoration: none;
    }
    .wordmark:hover { text-decoration: none; }
    .wordmark-img { display: block; height: 40px; width: auto; }

    .header-nav {
      display: flex;
      align-items: center;
      gap: 26px;
    }
    .header-nav a.navlink {
      color: var(--slate);
      font-size: 14.5px;
      font-weight: 500;
      text-decoration: none;
    }
    .header-nav a.navlink:hover { color: var(--navy); text-decoration: none; border-bottom: 2px solid var(--copper); padding-bottom: 2px; }

    .header-actions { display: flex; align-items: center; gap: 14px; }
    .header-call {
      color: var(--navy);
      font-weight: 700;
      font-size: 15px;
      white-space: nowrap;
      text-decoration: none;
    }
    .header-call:hover { color: var(--copper-dark); text-decoration: none; }
    .header-call .dot { color: var(--green); }

    /* language toggle pill */
    .lang-pill {
      display: inline-flex;
      border: 1.5px solid var(--border);
      border-radius: 999px;
      overflow: hidden;
      background: var(--white);
    }
    .lang-pill button {
      background: transparent;
      border: none;
      cursor: pointer;
      font-family: "DM Sans", sans-serif;
      font-weight: 700;
      font-size: 13px;
      color: var(--text-secondary);
      padding: 7px 13px;
      line-height: 1;
    }
    .lang-pill button[aria-pressed="true"] {
      background: var(--navy);
      color: var(--white);
    }

    .menu-toggle { display: none; }

    /* =====================================================================
       TRUST RIBBON
       ===================================================================== */
    .trust-ribbon {
      background: var(--navy);
      color: rgba(255,255,255,.92);
      font-size: 13.5px;
    }
    .trust-ribbon .wrap {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 26px;
      align-items: center;
      justify-content: center;
      padding-top: 11px;
      padding-bottom: 11px;
    }
    .trust-ribbon .ribbon-item { display: inline-flex; align-items: center; gap: 7px; white-space: nowrap; }
    .trust-ribbon .ic { color: #6FD1A4; font-weight: 700; }
    .trust-ribbon .star { color: var(--copper); }
    .trust-ribbon .sep { color: rgba(255,255,255,.25); }

    /* =====================================================================
       HERO
       ===================================================================== */
    .hero { padding: 56px 0 64px; }
    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 38px;
    }
    .hero-copy .eyebrow { color: var(--copper); }
    .hero h1 {
      font-size: clamp(32px, 5vw, 46px);
      margin-bottom: 18px;
    }
    .hero h1 .arrow { color: var(--copper); font-style: normal; }
    .hero .subhead {
      font-size: 17px;
      color: var(--slate);
      max-width: 560px;
      margin-bottom: 22px;
    }

    .hero-steps {
      list-style: none;
      padding: 0;
      margin: 0 0 24px;
      display: flex;
      flex-wrap: wrap;
      gap: 10px 14px;
    }
    .hero-steps li {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: var(--offwhite);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 7px 15px 7px 8px;
      font-size: 14px;
      font-weight: 500;
      color: var(--navy);
    }
    .mini-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 24px; height: 24px;
      border-radius: 50%;
      background: var(--navy);
      color: var(--white);
      font-weight: 700;
      font-size: 13px;
      flex: 0 0 auto;
    }

    .hero-cta-row { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 20px; }

    .hero .venus-note {
      font-size: 15px;
      color: var(--slate);
      margin: 0 0 6px;
    }
    .hero .venus-note strong { color: var(--navy); }
    .hero .ganas-line {
      font-style: italic;
      font-size: 16px;
      color: var(--navy);
      margin: 14px 0 0;
    }

    .micro-trust {
      display: flex;
      flex-wrap: wrap;
      gap: 6px 16px;
      margin-top: 22px;
      padding-top: 18px;
      border-top: 1px solid var(--border);
      font-size: 13.5px;
      color: var(--slate);
    }
    .micro-trust span { display: inline-flex; align-items: center; gap: 6px; white-space: nowrap; }
    .micro-trust .ic { color: var(--green); font-weight: 700; }
    .micro-trust .star { color: var(--copper); }

    /* ---- Hero form card ---- */
    .form-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 26px;
      box-shadow: var(--shadow-lg);
    }
    .form-card.hero-form { align-self: start; }
    .form-card h2 { font-size: 24px; margin-bottom: 6px; }
    .form-card .form-helper {
      font-size: 14.5px;
      color: var(--slate);
      margin: 0 0 20px;
    }

    .field { margin-bottom: 16px; }
    .field-row { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
    .field label.lbl,
    .field legend.lbl {
      display: block;
      font-weight: 700;
      font-size: 14px;
      color: var(--navy);
      margin-bottom: 6px;
    }
    .req { color: var(--copper); }
    .opt { color: var(--text-muted); font-weight: 400; font-style: italic; }
    .field input[type="text"],
    .field input[type="tel"],
    .field input[type="email"],
    .field input[type="number"],
    .field input[type="date"],
    .field input[type="file"],
    .field select,
    .field textarea {
      width: 100%;
      padding: 12px 13px;
      font-family: "DM Sans", sans-serif;
      font-size: 16px;
      color: var(--navy);
      background: var(--white);
      border: 1.5px solid var(--border);
      border-radius: 8px;
    }
    .field textarea { resize: vertical; min-height: 76px; }
    .field input:hover, .field select:hover, .field textarea:hover { border-color: #DEDEDE; }
    .field input:focus, .field select:focus, .field textarea:focus {
      outline: none;
      border-color: var(--copper);
      box-shadow: 0 0 0 3px rgba(193,122,58,.18);
    }
    .field .helper { display: block; font-size: 12.5px; color: var(--text-secondary); margin-top: 5px; }
    .field input[type="file"] {
      padding: 9px 12px;
      font-size: 14px;
      background: var(--offwhite);
      cursor: pointer;
    }

    .form-microtrust {
      display: flex;
      flex-wrap: wrap;
      gap: 4px 14px;
      margin-top: 14px;
      font-size: 13px;
      color: var(--green);
      font-weight: 500;
    }
    .form-microtrust span { display: inline-flex; align-items: center; gap: 5px; }

    .form-fallback { font-size: 14px; color: var(--slate); margin: 14px 0 0; }

    /* success state */
    .form-success {
      display: none;
      text-align: center;
      padding: 18px 6px 6px;
    }
    .form-success .check-badge {
      width: 64px; height: 64px;
      margin: 0 auto 16px;
      border-radius: 50%;
      background: var(--green);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-size: 32px;
    }
    .form-success h3 { font-size: 25px; margin-bottom: 8px; }
    .form-success p { color: var(--slate); font-size: 16px; }
    .form-card.is-success form { display: none; }
    .form-card.is-success .form-success { display: block; }

    /* =====================================================================
       PHOTO PLACEHOLDERS — premium navy/copper treatments
       ===================================================================== */
    .photo-ph {
      position: relative;
      border-radius: var(--radius);
      overflow: hidden;
      background:
        linear-gradient(135deg, rgba(193,122,58,.16), rgba(27,40,56,.06)),
        linear-gradient(160deg, #243446 0%, #1B2838 60%, #16212e 100%);
      border: 1px solid rgba(255,255,255,.06);
      box-shadow: var(--shadow-md);
      min-height: 220px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 28px;
      color: #fff;
    }
    .photo-ph::after {
      content: "";
      position: absolute;
      inset: 0;
      background: radial-gradient(circle at 28% 25%, rgba(193,122,58,.30), transparent 55%);
      pointer-events: none;
    }
    .photo-ph .ph-icon {
      position: relative;
      width: 52px; height: 52px;
      border-radius: 50%;
      border: 2px solid rgba(255,255,255,.35);
      display: flex; align-items: center; justify-content: center;
      margin-bottom: 14px;
      font-size: 22px;
      color: var(--copper);
      background: rgba(255,255,255,.06);
    }
    .photo-ph .ph-label {
      position: relative;
      font-family: "DM Serif Display", serif;
      font-size: 19px;
      margin: 0 0 6px;
      color: #fff;
    }
    .photo-ph .ph-cap {
      position: relative;
      font-size: 12.5px;
      letter-spacing: .4px;
      color: rgba(255,255,255,.66);
      margin: 0;
    }
    .photo-ph .ph-tag {
      position: absolute;
      bottom: 12px; left: 12px;
      font-size: 11px;
      letter-spacing: .5px;
      text-transform: uppercase;
      color: rgba(255,255,255,.55);
      background: rgba(0,0,0,.28);
      padding: 4px 9px;
      border-radius: 6px;
      border: 1px solid rgba(255,255,255,.12);
    }
    .photo-ph.short { min-height: 160px; }

    /* =====================================================================
       HOW IT WORKS
       ===================================================================== */
    .section-head { max-width: 720px; margin-bottom: 36px; }
    .section-head.center { margin-left: auto; margin-right: auto; text-align: center; }
    .section-head h2 { font-size: clamp(26px, 4vw, 34px); }
    .section-head p { color: var(--slate); font-size: 18px; margin-bottom: 0; }

    .steps { display: grid; grid-template-columns: 1fr; gap: 20px; }
    .step-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 26px;
      box-shadow: var(--shadow-sm);
    }
    .step-num {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 46px; height: 46px;
      border-radius: 50%;
      background: var(--navy);
      color: var(--white);
      font-family: "DM Serif Display", serif;
      font-size: 22px;
      margin-bottom: 16px;
    }
    .step-card h3 { font-size: 23px; margin-bottom: 10px; }
    .step-card p { color: var(--slate); font-size: 15.5px; margin-bottom: 0; }
    .step-card .es-aside { display: block; font-style: italic; color: var(--text-secondary); font-size: 14px; margin-top: 8px; }

    .deadline-note {
      margin-top: 30px;
      background: var(--white);
      border: 1px solid var(--border);
      border-left: 4px solid var(--green);
      border-radius: 0 8px 8px 0;
      padding: 20px 22px;
      font-size: 16px;
      color: var(--navy);
    }
    .deadline-note strong { color: var(--green); }
    .center-cta { text-align: center; margin-top: 34px; }

    /* =====================================================================
       TRANSFORMATION (before / after)
       ===================================================================== */
    .ba-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 28px;
    }
    .ba-card {
      border-radius: var(--radius);
      padding: 28px 26px;
      border: 1px solid var(--border);
    }
    .ba-before { background: var(--offwhite); }
    .ba-after {
      background: var(--navy);
      color: #fff;
      border-color: transparent;
    }
    .ba-card .ba-tag {
      font-family: "DM Sans", sans-serif;
      font-weight: 500;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 12px;
    }
    .ba-before .ba-tag { color: var(--text-secondary); }
    .ba-after .ba-tag { color: var(--copper); }
    .ba-card p { font-size: 16px; margin-bottom: 0; line-height: 1.62; }
    .ba-before p { color: var(--slate); }
    .ba-after p { color: rgba(255,255,255,.92); }

    .ba-truth {
      max-width: 760px;
      font-size: 19px;
      color: var(--navy);
    }
    .ba-truth strong { color: var(--navy); }
    .ba-truth .es-aside { display: block; font-style: italic; color: var(--text-secondary); font-size: 16px; margin-top: 10px; }

    /* =====================================================================
       RISK REVERSAL — three promises
       ===================================================================== */
    .promise-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 8px;
    }
    .promise-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 28px 24px;
      box-shadow: var(--shadow-sm);
    }
    .promise-icon {
      width: 44px; height: 44px;
      border-radius: 12px;
      background: rgba(30,107,74,.10);
      color: var(--green);
      display: flex; align-items: center; justify-content: center;
      font-size: 22px;
      font-weight: 700;
      margin-bottom: 16px;
    }
    .promise-card h3 { font-size: 21px; margin-bottom: 8px; }
    .promise-card p { color: var(--slate); font-size: 15px; margin-bottom: 0; }
    .promise-foot {
      margin-top: 26px;
      text-align: center;
      font-style: italic;
      font-size: 18px;
      color: var(--navy);
    }

    /* =====================================================================
       HUMAN / BILINGUAL (Venus + Lynwood)
       ===================================================================== */
    .human-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 34px;
      align-items: center;
    }
    .human-copy h2 { font-size: clamp(27px, 4vw, 38px); }
    .human-copy p { color: var(--slate); font-size: 16.5px; }
    .human-copy .ganas-line {
      font-style: italic;
      color: var(--navy);
      font-size: 18px;
      margin-top: 6px;
    }
    .human-actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 22px; }
    .venus-card-aside {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow-md);
      overflow: hidden;
    }
    .venus-photo {
      display: block;
      width: 100%;
      height: auto;
      aspect-ratio: 1 / 1;
      object-fit: cover;
    }
    .venus-card-aside .v-meta {
      padding: 18px 20px;
      display: flex;
      align-items: center;
      gap: 14px;
    }
    .v-avatar {
      width: 56px; height: 56px;
      border-radius: 50%;
      background: linear-gradient(150deg, var(--copper), #8c5526);
      color: #fff;
      display: flex; align-items: center; justify-content: center;
      font-family: "DM Serif Display", serif;
      font-size: 24px;
      flex: 0 0 auto;
    }
    .v-meta .v-name { font-weight: 700; color: var(--navy); margin: 0; font-size: 16px; }
    .v-meta .v-role { color: var(--text-secondary); margin: 2px 0 0; font-size: 13.5px; }

    /* =====================================================================
       PROOF WALL / HERITAGE
       ===================================================================== */
    .badge-row {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-bottom: 32px;
    }
    .trust-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 9px 16px;
      font-size: 14px;
      font-weight: 500;
      color: var(--navy);
    }
    .trust-badge .star { color: var(--copper); }
    .trust-badge .ic { color: var(--green); font-weight: 700; }

    .craft-donut {
      display: grid;
      grid-template-columns: 1fr;
      gap: 22px;
      margin-bottom: 34px;
    }
    .craft-block, .donut-block {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 26px 24px;
      box-shadow: var(--shadow-sm);
    }
    .donut-block { border-left: 4px solid var(--copper); }
    .craft-block h3, .donut-block h3 { font-size: 21px; margin-bottom: 10px; }
    .craft-block p, .donut-block p { color: var(--slate); font-size: 15.5px; margin-bottom: 0; }
    .donut-block .donut-myth { color: var(--navy); }
    .donut-block .donut-tag { font-weight: 700; color: var(--copper); }

    .reviews-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .review-card {
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 22px 22px;
      box-shadow: var(--shadow-sm);
    }
    .review-card .stars { color: var(--copper); font-size: 14px; letter-spacing: 1px; margin-bottom: 10px; }
    .review-card blockquote { margin: 0 0 14px; font-style: italic; color: var(--slate); font-size: 15px; line-height: 1.6; }
    .review-card .reviewer { font-weight: 700; color: var(--navy); font-size: 14px; }
    .review-card .source { color: var(--text-muted); font-size: 12.5px; }
    .reviews-disclaimer { margin-top: 18px; font-size: 13px; color: var(--text-muted); font-style: italic; }

    /* =====================================================================
       PRODUCT GRID
       ===================================================================== */
    .product-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 20px;
      margin-bottom: 26px;
    }
    .product-card {
      display: flex;
      flex-direction: column;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      box-shadow: var(--shadow-sm);
      transition: transform .14s ease, box-shadow .14s ease;
      scroll-margin-top: 120px;
    }
    .product-card:hover { transform: translateY(-2px); box-shadow: 0 6px 18px rgba(27,40,56,.07); }
    .product-thumb {
      aspect-ratio: 4 / 3;
      background: var(--offwhite);
      position: relative;
      overflow: hidden;
    }
    .product-thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .product-thumb .pt-cap {
      font-size: 10.5px;
      letter-spacing: .5px;
      text-transform: uppercase;
      color: rgba(255,255,255,.6);
      background: rgba(0,0,0,.26);
      border: 1px solid rgba(255,255,255,.12);
      padding: 3px 8px;
      border-radius: 5px;
    }
    .product-body { padding: 20px 20px 22px; display: flex; flex-direction: column; flex: 1; }
    .product-body h3 { font-size: 19px; margin-bottom: 6px; }
    .product-body .starting {
      color: var(--green);
      font-weight: 700;
      font-size: 14px;
      margin: 0 0 8px;
    }
    .product-body .pdesc { color: var(--slate); font-size: 14.5px; margin: 0 0 16px; flex: 1; }
    .product-body .pcta {
      align-self: flex-start;
      color: var(--copper);
      font-weight: 700;
      font-size: 14.5px;
      background: none;
      border: none;
      padding: 0;
      cursor: pointer;
      font-family: "DM Sans", sans-serif;
    }
    .product-body .pcta:hover { color: var(--copper-dark); text-decoration: underline; }

    .grid-foot {
      display: flex;
      flex-wrap: wrap;
      gap: 8px 18px;
      align-items: center;
      justify-content: space-between;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 18px 22px;
    }
    .grid-foot .gf-help { color: var(--slate); font-size: 15px; margin: 0; }
    .grid-foot .gf-code {
      font-size: 14px;
      color: var(--green);
      font-weight: 700;
      white-space: nowrap;
    }

    /* =====================================================================
       QUOTE FORM SECTION (second instance)
       ===================================================================== */
    .quote-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 34px;
      align-items: start;
    }
    .quote-intro h2 { font-size: clamp(28px, 4vw, 40px); }
    .quote-intro p { color: var(--slate); font-size: 16.5px; }
    .quote-intro .fields-line { font-size: 14px; color: var(--text-secondary); }
    .quote-intro .anchor-line {
      background: var(--offwhite);
      border-radius: 10px;
      padding: 16px 18px;
      font-size: 14.5px;
      color: var(--slate);
      margin-top: 8px;
    }
    .quote-intro .anchor-line strong { color: var(--navy); }
    .quote-contact { margin-top: 18px; font-size: 15px; color: var(--navy); }

    /* =====================================================================
       FOOTER
       ===================================================================== */
    .site-footer { color: #D8DEE5; }
    .site-footer .wrap { padding-top: 56px; padding-bottom: 40px; }
    .footer-tagline {
      font-family: "Cooper Black", "DM Serif Display", serif;
      font-weight: normal;
      font-size: clamp(26px, 4vw, 36px);
      color: #fff;
      margin: 0 0 8px;
    }
    .footer-sub { color: #AEBAC6; font-style: italic; margin: 0 0 30px; font-size: 16px; }
    .footer-cols {
      display: grid;
      grid-template-columns: 1fr;
      gap: 30px;
      padding-bottom: 30px;
      border-bottom: 1px solid rgba(255,255,255,.14);
    }
    .footer-cols h4 {
      font-family: "DM Sans", sans-serif;
      font-weight: 500;
      font-size: 11px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: #8FA0B0;
      margin: 0 0 14px;
    }
    .footer-wordmark { font-family: "DM Serif Display", serif; font-size: 24px; color: #fff; margin-bottom: 12px; }
    .footer-wordmark .amp { color: var(--copper); }
    .footer-cols p { color: #C6D0DA; font-size: 14.5px; margin: 0 0 8px; }
    .footer-cols a { color: var(--copper); font-weight: 500; }
    .footer-cols a:hover { color: #e0a064; }
    .footer-links { list-style: none; padding: 0; margin: 0; }
    .footer-links li { margin-bottom: 9px; }
    .footer-links a { color: #C6D0DA; font-weight: 400; }
    .footer-links a:hover { color: #fff; }

    .footer-contact-line { display: flex; align-items: center; gap: 8px; }

    .footer-lang { margin: 16px 0 0; }
    .footer-lang .lang-pill { border-color: rgba(255,255,255,.22); background: transparent; }
    .footer-lang .lang-pill button { color: #AEBAC6; }
    .footer-lang .lang-pill button[aria-pressed="true"] { background: var(--copper); color: #fff; }

    .footer-bottom {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      justify-content: space-between;
      align-items: center;
      padding-top: 24px;
    }
    .footer-bottom .copy { color: #8FA0B0; font-size: 13px; margin: 0; }

    /* =====================================================================
       FLOATING CONTACT
       ===================================================================== */
    .float-contact {
      position: fixed;
      right: 18px;
      bottom: 18px;
      z-index: 90;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
    .float-btn {
      display: inline-flex;
      align-items: center;
      gap: 9px;
      background: var(--green);
      color: #fff;
      font-weight: 700;
      font-size: 14px;
      padding: 12px 16px;
      border-radius: 999px;
      box-shadow: var(--shadow-md);
      text-decoration: none;
    }
    .float-btn:hover { background: #185a3e; color: #fff; text-decoration: none; }
    .float-btn.call { background: var(--copper); }
    .float-btn.call:hover { background: var(--copper-dark); }
    .float-btn .fic { font-size: 16px; }

    /* =====================================================================
       RESPONSIVE
       ===================================================================== */
    @media (min-width: 768px) {
      .steps { grid-template-columns: repeat(3, 1fr); }
      .promise-grid { grid-template-columns: repeat(3, 1fr); }
      .ba-grid { grid-template-columns: 1fr 1fr; }
      .craft-donut { grid-template-columns: 1fr 1fr; }
      .reviews-grid { grid-template-columns: repeat(3, 1fr); }
      .product-grid { grid-template-columns: repeat(2, 1fr); }
      .footer-cols { grid-template-columns: 2fr 1fr 1fr; }
    }

    @media (min-width: 1024px) {
      .hero-grid { grid-template-columns: 1.05fr .95fr; align-items: start; }
      .human-grid { grid-template-columns: 1.3fr .7fr; }
      .product-grid { grid-template-columns: repeat(3, 1fr); }
      .quote-grid { grid-template-columns: .9fr 1.1fr; }
    }

    /* mobile nav collapse */
    @media (max-width: 920px) {
      .header-nav .navlink { display: none; }
      .header-call { display: none; }
    }
    @media (max-width: 560px) {
      section { padding: 50px 0; }
      .field-row { grid-template-columns: 1fr; }
      .float-contact .label-text { display: none; }
      .float-btn { padding: 14px; }
      .wordmark-img { height: 30px; }
      .header-actions > .btn { display: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      * { scroll-behavior: auto !important; transition: none !important; }
    }
    /* ---- Footer logo ---- */
    .footer-logo { height: 40px; width: auto; margin: 0 0 14px; filter: brightness(0) invert(1); }

    /* ---- Parallax break band ---- */
    .px-band {
      position: relative;
      overflow: hidden;
      padding: 0;
      isolation: isolate;
    }
    .px-bg {
      position: absolute;
      inset: -12% 0;
      background-image: url({{ 'lp-card-tents.jpg' | asset_url }});
      background-size: cover;
      background-position: center 40%;
      will-change: transform;
      z-index: -2;
    }
    .px-band::after {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(180deg, rgba(27,40,56,.82), rgba(27,40,56,.72));
      z-index: -1;
    }
    .px-inner { padding: 96px 24px; text-align: center; color: #fff; }
    .px-eyebrow {
      font-size: 11px; font-weight: 500; letter-spacing: 2px;
      text-transform: uppercase; color: #E4B183; margin: 0 0 12px;
    }
    .px-band h2 { color: #fff; font-size: clamp(26px, 3.6vw, 38px); margin: 0 0 14px; }
    .px-sub { color: rgba(255,255,255,.9); font-size: 17px; max-width: 640px; margin: 0 auto 24px; }
    .px-cta { background: var(--copper); }
    .px-cta:hover { background: var(--copper-dark); }
    @media (max-width: 560px) { .px-inner { padding: 66px 20px; } }

    /* =====================================================================
       V2 ADDITIONS — dropzone, two-step modal, logo marquee, packages,
       scroll-reveal. All selectors namespaced: .dz- .pngm- .mq- .pkg- .rv
       ===================================================================== */

    /* ---- Dropzone (hero card + compact variant in the main form) ---- */
    .dz-card { position: relative; }
    .dz-card.is-success .dz-ui { display: none; }
    .dz-card.is-success .dz-success-probe { display: block; }
    .form-success h2 { font-size: 25px; margin-bottom: 8px; }
    .dz {
      border: 2px dashed #D8C4AE;
      border-radius: 10px;
      background: var(--offwhite);
      text-align: center;
      padding: 30px 18px 24px;
      cursor: pointer;
      transition: border-color .2s ease, background .2s ease, transform .2s ease;
    }
    .dz:hover, .dz:focus-visible { border-color: var(--copper); background: #FCF7F1; }
    .dz.drag { border-color: var(--copper); background: #FAF1E7; transform: scale(1.012); }
    .dz-ic { width: 42px; height: 42px; color: var(--copper); margin: 0 auto 10px; display: block; }
    .dz-line1 { font-size: 16.5px; color: var(--navy); margin: 0 0 4px; }
    .dz-line2 { font-size: 14px; color: var(--slate); margin: 0; }
    .dz-browse { color: var(--copper); font-weight: 700; text-decoration: underline; }
    .dz-formats { font-size: 12px; color: var(--text-muted); margin: 10px 0 0; letter-spacing: .3px; }
    .dz-spin {
      display: block;
      width: 34px; height: 34px;
      margin: 0 auto 12px;
      border-radius: 50%;
      border: 3px solid #EAD9C6;
      border-top-color: var(--copper);
      animation: dz-rot .8s linear infinite;
    }
    @keyframes dz-rot { to { transform: rotate(360deg); } }
    .dz-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      background: #EAF4EE;
      color: var(--green);
      font-weight: 700;
      font-size: 14.5px;
      border-radius: 999px;
      padding: 8px 16px;
      margin: 0 0 8px;
      max-width: 100%;
      overflow-wrap: anywhere;
    }
    .dz-chip-ic { flex: 0 0 auto; }
    .dz-change {
      background: none;
      border: none;
      cursor: pointer;
      font-family: "DM Sans", sans-serif;
      font-size: 13px;
      color: var(--copper);
      text-decoration: underline;
      margin-top: 8px;
      padding: 4px 6px;
    }
    .dz-change:hover { color: var(--copper-dark); }
    .dz-err .dz-line1 { color: #A33A2A; }
    .dz-busy-name, .dz-done-name { overflow-wrap: anywhere; }
    .dz-continue { margin-top: 16px; }
    .dz-skip {
      display: block;
      width: 100%;
      background: none;
      border: none;
      cursor: pointer;
      font-family: "DM Sans", sans-serif;
      font-size: 13.5px;
      color: var(--slate);
      text-decoration: underline;
      text-align: center;
      margin: 10px 0 0;
      padding: 6px;
    }
    .dz-skip:hover { color: var(--navy); }
    .dz-mini { padding: 18px 14px 14px; }
    .dz-mini .dz-ic { width: 30px; height: 30px; margin-bottom: 6px; }
    .dz-mini .dz-line1 { font-size: 14.5px; }
    .dz-mini .dz-formats { margin-top: 6px; }

    /* success-state variants (with file vs without) */
    .suc-filechip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      background: var(--offwhite);
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 7px 15px;
      font-size: 14px;
      color: var(--navy);
      font-weight: 500;
      max-width: 100%;
      overflow-wrap: anywhere;
    }
    .suc-pricing {
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid var(--border);
      text-align: center;
    }
    .suc-pricing-title { font-weight: 700; font-size: 14px; color: var(--navy); margin: 0 0 6px; }
    .suc-anchor { font-size: 13.5px; color: var(--slate); margin: 0 0 10px; }
    .suc-note { font-size: 13px; color: var(--text-secondary); margin: 0; }

    /* ---- Two-step modal ---- */
    .pngm-scrim {
      position: fixed;
      inset: 0;
      z-index: 150;
      background: rgba(27, 40, 56, .55);
      backdrop-filter: blur(3px);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 18px;
      opacity: 0;
      transition: opacity .25s ease;
    }
    .pngm-scrim[hidden] { display: none; }
    .pngm-scrim.open { opacity: 1; }
    .pngm {
      background: var(--white);
      border-radius: 12px;
      box-shadow: 0 24px 70px rgba(27, 40, 56, .35);
      width: 100%;
      max-width: 560px;
      max-height: 92vh;
      max-height: min(92vh, 92dvh);
      overflow-y: auto;
      padding: 30px 28px 26px;
      position: relative;
      transform: translateY(14px) scale(.985);
      transition: transform .25s cubic-bezier(.22, .61, .36, 1);
    }
    .pngm-scrim.open .pngm { transform: none; }
    .pngm h2 { font-size: 24px; margin: 0 34px 14px 0; }
    .pngm-close {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 38px; height: 38px;
      border: none;
      border-radius: 50%;
      background: var(--offwhite);
      color: var(--slate);
      font-size: 22px;
      line-height: 1;
      cursor: pointer;
      transition: background .2s ease, color .2s ease;
    }
    .pngm-close:hover { background: var(--border); color: var(--navy); }
    .pngm-filechip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      font-size: 13.5px;
      border-radius: 999px;
      padding: 7px 14px;
      margin: 0 0 18px;
      max-width: 100%;
      overflow-wrap: anywhere;
    }
    .pngm-filechip[hidden] { display: none; }
    .pngm-busy .dz-spin { width: 16px; height: 16px; border-width: 2px; margin: 0; display: inline-block; }
    .pngm-has { background: #EAF4EE; color: var(--green); font-weight: 600; }
    .pngm-none { background: var(--offwhite); color: var(--slate); border: 1px solid var(--border); }
    @media (max-width: 560px) {
      .pngm-scrim { padding: 0; align-items: flex-end; }
      .pngm { border-radius: 14px 14px 0 0; max-height: 94vh; max-height: 94dvh; padding: 24px 20px 20px; }
    }

    /* ---- Client logo marquee ---- */
    .mq-section { padding: 34px 0 42px; border-bottom: 1px solid var(--border); }
    .mq-eyebrow { text-align: center; margin-bottom: 20px; }
    .mq {
      overflow: hidden;
      -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
      mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    }
    .mq-track {
      display: flex;
      align-items: center;
      width: max-content;
      animation: mq-scroll 42s linear infinite;
    }
    .mq:hover .mq-track { animation-play-state: paused; }
    .mq-set { display: inline-flex; align-items: center; gap: 76px; padding-right: 76px; }
    .mq-item { display: inline-flex; align-items: center; flex: 0 0 auto; }
    .mq-item img {
      height: 56px;
      width: auto;
      max-width: 210px;
      object-fit: contain;
      filter: grayscale(1);
      opacity: .68;
      transition: filter .3s ease, opacity .3s ease;
    }
    @media (max-width: 560px) {
      .mq-item img { height: 44px; max-width: 165px; }
      .mq-set { gap: 52px; padding-right: 52px; }
    }
    .mq-item:hover img { filter: none; opacity: 1; }
    .mq-alt {
      display: none;
      font-weight: 700;
      font-size: 16px;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      color: var(--slate);
      opacity: .7;
      white-space: nowrap;
    }
    .mq-item.noimg img { display: none; }
    .mq-item.noimg .mq-alt { display: inline; }
    @keyframes mq-scroll { to { transform: translateX(-50%); } }

    /* ---- Packages ---- */
    .pkg-sub { color: var(--slate); font-size: 16px; max-width: 620px; margin: 0; }
    .pkg-grid { display: grid; grid-template-columns: 1fr; gap: 20px; margin-top: 34px; }
    .pkg-card {
      position: relative;
      background: var(--white);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 28px 24px 24px;
      box-shadow: var(--shadow-sm);
      display: flex;
      flex-direction: column;
      transition: transform .25s ease, box-shadow .25s ease;
    }
    .pkg-card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); }
    .pkg-featured { border: 2px solid var(--copper); box-shadow: var(--shadow-md); }
    .pkg-flag {
      position: absolute;
      top: -13px;
      left: 22px;
      background: var(--copper);
      color: var(--white);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.4px;
      text-transform: uppercase;
      border-radius: 999px;
      padding: 5px 13px;
      margin: 0;
    }
    .pkg-card h3 { font-size: 21px; margin: 0 0 10px; }
    .pkg-from {
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 1.6px;
      text-transform: uppercase;
      color: var(--text-secondary);
      margin: 0;
    }
    .pkg-price {
      font-family: "Cooper Black", "DM Serif Display", Georgia, serif;
      font-size: 38px;
      color: var(--navy);
      line-height: 1.05;
      margin: 2px 0 10px;
    }
    .pkg-tag { font-size: 14.5px; color: var(--slate); margin: 0 0 14px; min-height: 2.6em; }
    .pkg-list { list-style: none; padding: 0; margin: 0 0 20px; flex: 1; }
    .pkg-list li {
      position: relative;
      padding-left: 24px;
      font-size: 14.5px;
      color: var(--slate);
      margin-bottom: 8px;
    }
    .pkg-list li::before {
      content: "\2713";
      position: absolute;
      left: 0;
      color: var(--green);
      font-weight: 700;
    }
    .pkg-fine { color: var(--text-muted); font-style: italic; }
    .pkg-note { text-align: center; font-size: 13px; color: var(--text-secondary); margin: 26px 0 0; }
    @media (min-width: 768px) {
      .pkg-grid { grid-template-columns: repeat(3, 1fr); }
    }

    /* ---- Scroll-reveal + card depth (motion-safe only) ---- */
    @media (prefers-reduced-motion: no-preference) {
      .rv {
        opacity: 0;
        transform: translateY(24px);
        transition: opacity .55s ease, transform .55s cubic-bezier(.22, .61, .36, 1);
        transition-delay: var(--rvd, 0ms);
      }
      .rv.rv-in { opacity: 1; transform: none; }
      .steps > *, .promise-grid > *, .reviews-grid > *, .product-grid > * {
        transition: transform .25s ease, box-shadow .25s ease;
      }
      .steps > *:hover, .promise-grid > *:hover, .reviews-grid > *:hover, .product-grid > *:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-lg);
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .mq-track { animation: none; width: auto; }
      .mq-set[aria-hidden="true"] { display: none; }
      .mq-set { flex-wrap: wrap; justify-content: center; row-gap: 16px; padding-right: 0; }
      .mq { -webkit-mask-image: none; mask-image: none; }
      .dz-spin { animation: none; }
    }
