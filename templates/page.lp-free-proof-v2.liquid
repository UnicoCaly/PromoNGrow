  <script>
    (function () {
      'use strict';

      /* ---------------- LANGUAGE TOGGLE (EN default) ---------------- */
      var htmlEl = document.documentElement;
      function setLang(lang) {
        var isEs = lang === 'es';
        htmlEl.classList.toggle('lang-mode-es', isEs);
        htmlEl.classList.toggle('lang-mode-en', !isEs);
        htmlEl.setAttribute('lang', isEs ? 'es' : 'en');
        document.querySelectorAll('.lang-pill button').forEach(function (b) {
          b.setAttribute('aria-pressed', String(b.getAttribute('data-lang') === lang));
        });
      }
      document.querySelectorAll('.lang-pill button').forEach(function (btn) {
        btn.addEventListener('click', function () { setLang(btn.getAttribute('data-lang')); });
      });
      /* sync the toggle to the server-set default language (EN page vs ES /prueba-gratis page) */
      setLang(htmlEl.classList.contains('lang-mode-es') ? 'es' : 'en');

      /* ---------------- PRODUCT CARD -> jump to form + preselect ---------------- */
      document.querySelectorAll('.pcta').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var prod = btn.getAttribute('data-product');
          var sel = document.getElementById('m-product');
          if (sel && prod) sel.value = prod;
          var target = document.getElementById('quote-form');
          if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
          var nameField = document.getElementById('m-name');
          if (nameField) setTimeout(function () { nameField.focus({ preventScroll: true }); }, 500);
        });
      });

      /* Forms POST natively to Shopify's contact handler (Shopify Liquid contact form).
         On the success re-render, each form's posted_successfully? block dispatches
         png:quote_request_submitted, which png-tracking-pixels maps to Meta Lead +
         Google Ads conversion. No client-side submit interception needed here. */
    })();
  </script>

  <script>
    /* V2: drag-drop logo upload -> Cloudflare Worker, two-step modal, scroll-reveal. */
    (function () {
      'use strict';
      if (window.__pngV2Init) return;
      window.__pngV2Init = true;

      var UPLOAD_BASE = 'https://png-logo-upload.carlos-154.workers.dev';
      var ALLOWED = ['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg', 'bmp', 'tif', 'tiff', 'heic', 'heif', 'pdf', 'ai', 'eps', 'psd'];
      var MAX_BYTES = 15 * 1024 * 1024;

      function isEs() { return document.documentElement.classList.contains('lang-mode-es'); }
      function t(en, es) { return isEs() ? es : en; }

      /* ---------------- UPLOAD ---------------- */
      window.__pngLogo = null;

      function announce(dz, msg) {
        var el = dz && dz.parentNode ? dz.parentNode.querySelector('.dz-status') : null;
        if (el) el.textContent = msg;
      }
      function fillLogoInputs(url) {
        document.querySelectorAll('.png-logo-url').forEach(function (inp) { inp.value = url || ''; });
      }
      function updateModalChip() {
        var has = document.querySelector('.pngm-has');
        var none = document.querySelector('.pngm-none');
        var busy = document.querySelector('.pngm-busy');
        if (!has || !none) return;
        var state = window.__pngUploading ? 'busy' : (window.__pngLogo ? 'has' : 'none');
        has.hidden = state !== 'has';
        none.hidden = state !== 'none';
        if (busy) busy.hidden = state !== 'busy';
        if (state === 'has') has.querySelector('.pngm-filename').textContent = window.__pngLogo.name;
      }
      function setState(dz, state) {
        dz.querySelectorAll('.dz-state').forEach(function (el) { el.hidden = true; });
        var el = dz.querySelector('.dz-' + state);
        if (el) el.hidden = false;
        dz.classList.remove('drag');
      }

      function handleFile(dz, input, file) {
        if (!file) return;
        var ext = (file.name.indexOf('.') > -1 ? file.name.split('.').pop() : '').toLowerCase();
        if (ALLOWED.indexOf(ext) === -1) {
          setState(dz, 'err');
          dz.querySelector('.dz-err-msg').textContent = t(
            'That format won’t work here — use PNG, JPG, PDF, AI, EPS, SVG or PSD.',
            'Ese formato no sirve aquí — usa PNG, JPG, PDF, AI, EPS, SVG o PSD.');
          announce(dz, t('Upload failed: unsupported file type.', 'Error: tipo de archivo no compatible.'));
          window.__pngLogo = null; fillLogoInputs(''); updateModalChip();
          return;
        }
        if (file.size > MAX_BYTES) {
          setState(dz, 'err');
          dz.querySelector('.dz-err-msg').textContent = t(
            'That file is over 15 MB — try a smaller version, or continue and email it after.',
            'Pesa más de 15 MB — intenta una versión más ligera, o continúa y mándalo por correo.');
          announce(dz, t('Upload failed: file too large.', 'Error: archivo demasiado grande.'));
          window.__pngLogo = null; fillLogoInputs(''); updateModalChip();
          return;
        }
        setState(dz, 'busy');
        window.__pngUploading = true;
        updateModalChip();
        var busyName = dz.querySelector('.dz-busy-name');
        if (busyName) busyName.textContent = file.name;
        announce(dz, t('Uploading ' + file.name + '…', 'Subiendo ' + file.name + '…'));

        fetch(UPLOAD_BASE + '/upload?name=' + encodeURIComponent(file.name), { method: 'POST', body: file })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (!data || !data.ok || !data.url) throw new Error((data && data.error) || 'upload');
            window.__pngUploading = false;
            window.__pngLogo = { url: data.url, name: file.name };
            fillLogoInputs(data.url);
            updateModalChip();
            setState(dz, 'done');
            var doneName = dz.querySelector('.dz-done-name');
            if (doneName) doneName.textContent = file.name;
            announce(dz, t('Logo uploaded: ' + file.name, 'Logo subido: ' + file.name));
          })
          .catch(function () {
            window.__pngUploading = false;
            window.__pngLogo = null;
            fillLogoInputs('');
            updateModalChip();
            setState(dz, 'err');
            dz.querySelector('.dz-err-msg').textContent = t(
              'No worries — you can continue and email the file after.',
              'No pasa nada — puedes continuar y mandar el archivo por correo.');
            announce(dz, t('Upload failed. You can continue without the file.', 'Error al subir. Puedes continuar sin el archivo.'));
          });
      }

      document.querySelectorAll('.dz').forEach(function (dz) {
        var input = dz.querySelector('input[type="file"]');
        if (!input) return;
        dz.addEventListener('click', function (e) {
          if (e.target.closest('.dz-change')) { e.stopPropagation(); input.value = ''; input.click(); return; }
          input.click();
        });
        dz.addEventListener('keydown', function (e) {
          if (e.target !== dz) return;
          if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); input.click(); }
        });
        input.addEventListener('change', function () { handleFile(dz, input, input.files && input.files[0]); });
        ['dragenter', 'dragover'].forEach(function (ev) {
          dz.addEventListener(ev, function (e) { e.preventDefault(); dz.classList.add('drag'); });
        });
        dz.addEventListener('dragleave', function (e) {
          if (!dz.contains(e.relatedTarget)) dz.classList.remove('drag');
        });
        dz.addEventListener('drop', function (e) {
          e.preventDefault();
          dz.classList.remove('drag');
          var f = e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files[0];
          handleFile(dz, input, f);
        });
      });

      /* stop stray drops outside a dropzone from navigating away */
      ['dragover', 'drop'].forEach(function (ev) {
        document.addEventListener(ev, function (e) {
          if (!(e.target && e.target.closest && e.target.closest('.dz'))) e.preventDefault();
        });
      });

      /* ---------------- TWO-STEP MODAL ---------------- */
      var scrim = document.getElementById('png-modal');
      var opener = null;
      var hideTimer = null;

      function focusables() {
        if (!scrim) return [];
        return Array.prototype.filter.call(
          scrim.querySelectorAll('a[href], button:not([disabled]), input:not([type="hidden"]):not([disabled]), select, textarea, [tabindex]:not([tabindex="-1"])'),
          function (el) { return el.offsetParent !== null; });
      }
      function openModal(btn) {
        if (!scrim) return;
        opener = btn || null;
        var prod = btn && btn.getAttribute('data-product');
        if (prod) {
          ['x-product', 'm-product'].forEach(function (id) {
            var sel = document.getElementById(id);
            if (sel) sel.value = prod;
          });
        }
        updateModalChip();
        if (hideTimer) { clearTimeout(hideTimer); hideTimer = null; }
        scrim.hidden = false;
        requestAnimationFrame(function () { scrim.classList.add('open'); });
        document.documentElement.style.overflow = 'hidden';
        var first = document.getElementById('x-name');
        if (first) setTimeout(function () { first.focus({ preventScroll: true }); }, 120);
      }
      function closeModal() {
        if (!scrim || scrim.hidden) return;
        scrim.classList.remove('open');
        document.documentElement.style.overflow = '';
        hideTimer = setTimeout(function () { scrim.hidden = true; }, 250);
        if (opener) { try { opener.focus(); } catch (e) {} opener = null; }
      }
      document.querySelectorAll('[data-modal-open]').forEach(function (btn) {
        btn.addEventListener('click', function () { openModal(btn); });
      });
      if (scrim) {
        scrim.addEventListener('click', function (e) { if (e.target === scrim) closeModal(); });
        scrim.querySelectorAll('[data-modal-close]').forEach(function (btn) {
          btn.addEventListener('click', closeModal);
        });
        document.addEventListener('keydown', function (e) {
          if (scrim.hidden) return;
          if (e.key === 'Escape') { closeModal(); return; }
          if (e.key !== 'Tab') return;
          var f = focusables();
          if (!f.length) return;
          var first = f[0], last = f[f.length - 1];
          if (!scrim.contains(document.activeElement)) { e.preventDefault(); first.focus(); return; }
          if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
          else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
        });
      }

      /* remember whether a file rode along, for the success screen after reload */
      document.querySelectorAll('.pngm-form, .quote-form').forEach(function (f) {
        f.addEventListener('submit', function () {
          try {
            sessionStorage.setItem('png_logo_name', window.__pngLogo ? window.__pngLogo.name : '');
            sessionStorage.setItem('png_submit_src', f.classList.contains('pngm-form') ? 'modal' : 'main');
          } catch (e) {}
        });
      });

      /* server-side validation errors from a modal submit render inside the closed
         modal — reopen it so they're visible */
      if (scrim && scrim.querySelector('.errors')) {
        var errSrc = '';
        try { errSrc = sessionStorage.getItem('png_submit_src') || ''; } catch (e) {}
        if (errSrc === 'modal') openModal(null);
      }

      /* ---------------- SUCCESS STATE (after native POST reload) ---------------- */
      var success = document.querySelector('.form-success');
      if (success) {
        document.querySelectorAll('.dz-card').forEach(function (c) { c.classList.add('is-success'); });
        var logoName = '';
        try {
          logoName = sessionStorage.getItem('png_logo_name') || '';
          sessionStorage.removeItem('png_logo_name');
          sessionStorage.removeItem('png_submit_src');
        } catch (e) {}
        if (logoName) {
          document.querySelectorAll('.form-success').forEach(function (s) {
            var withFile = s.querySelector('.suc-file');
            var noFile = s.querySelector('.suc-nofile');
            if (withFile) {
              withFile.hidden = false;
              var nameEl = withFile.querySelector('.suc-filename');
              if (nameEl) nameEl.textContent = logoName;
            }
            if (noFile) noFile.hidden = true;
          });
        }
        setTimeout(function () {
          var card = success.closest('.form-card') || success;
          card.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 150);
      }

      /* ---------------- PARALLAX BAND ---------------- */
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var pxBand = document.querySelector('.px-band');
        var pxBg = pxBand && pxBand.querySelector('.px-bg');
        if (pxBg) {
          var pxTicking = false;
          var movePx = function () {
            var r = pxBand.getBoundingClientRect();
            if (r.bottom < 0 || r.top > window.innerHeight) { pxTicking = false; return; }
            // -1 (band below viewport) .. 1 (band above) -> gentle vertical drift
            var progress = (r.top + r.height / 2 - window.innerHeight / 2) / (window.innerHeight / 2 + r.height / 2);
            pxBg.style.transform = 'translate3d(0,' + (progress * 9).toFixed(2) + '%,0)';
            pxTicking = false;
          };
          var onPxScroll = function () {
            if (pxTicking) return;
            pxTicking = true;
            window.requestAnimationFrame(movePx);
          };
          window.addEventListener('scroll', onPxScroll, { passive: true });
          window.addEventListener('resize', onPxScroll, { passive: true });
          movePx();
        }
      }

      /* ---------------- SCROLL-REVEAL ---------------- */
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        var SELECTORS = [
          '.hero-copy', '.dz-card', '.mq-eyebrow', '.mq',
          '.section-head', '.steps > *', '.deadline-note', '.center-cta',
          '.pkg-grid > *', '.pkg-note', '.ba-grid > *', '.ba-truth',
          '.promise-grid > *', '.craft-donut > *', '.human-grid > *',
          '.reviews-grid > *', '.product-grid > *', '.quote-grid > *'
        ];
        var els = document.querySelectorAll(SELECTORS.join(', '));
        els.forEach(function (el) {
          el.classList.add('rv');
          var i = Array.prototype.indexOf.call(el.parentElement.children, el);
          el.style.setProperty('--rvd', (i % 6) * 70 + 'ms');
        });
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(function (entries) {
            entries.forEach(function (en) {
              if (en.isIntersecting) {
                en.target.classList.add('rv-in');
                io.unobserve(en.target);
                setTimeout(function () {
                  en.target.classList.remove('rv');
                  en.target.style.removeProperty('--rvd');
                }, 1000);
              }
            });
          }, { threshold: 0.1, rootMargin: '0px 0px -36px 0px' });
          els.forEach(function (el) { io.observe(el); });
        } else {
          els.forEach(function (el) { el.classList.add('rv-in'); });
        }
      }
    })();
  </script>

  {%- comment -%} Pixels load from png-tracking-pixels (head). Conversion fires via the
     png:quote_request_submitted event dispatched on form success. {%- endcomment -%}

