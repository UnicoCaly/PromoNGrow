<!-- Promo & Grow: Exit-Intent Bundle Popup -->
{%- comment -%}
  Renders only on product + collection pages.
  Skips homepage, cart, checkout, and account pages.
  Fires on desktop mouseout-to-top OR rapid mobile scroll-up.
  Shows once per session, armed after 5 seconds on page.
{%- endcomment -%}

{%- liquid
  assign show_popup = false
  if template contains 'product' or template contains 'collection'
    assign show_popup = true
  endif
  if template == 'index'
    assign show_popup = false
  endif
  if template contains 'cart' or template contains 'checkout' or template contains 'account' or template contains 'customers'
    assign show_popup = false
  endif

  comment
    Tier detection: on quote-first product pages, swap the bundle promo for a
    free-proof CTA (more relevant to the high-ticket custom buyer about to bounce).
    On collection pages and checkout-first product pages, keep the bundle promo.
  endcomment
  assign quote_first_types = 'Bundle,Event Displays & Backdrops,Event Tents & Canopies,Wall Art,Prints & Wraps' | split: ','
  assign exit_variant = 'bundle'
  if template contains 'product' and product != blank
    if quote_first_types contains product.type
      assign exit_variant = 'free-proof'
    endif
  endif
-%}

{%- if show_popup -%}
  {%- assign tent_product = all_products['10ft-x-10ft-event-tent-canopy'] -%}
  {%- assign flag_product = all_products['feather-convex-flag-copy'] -%}
  {%- assign throw_product = all_products['stretch-table-cover'] -%}

<div id="png-exit-popup" class="png-exit" data-exit-variant="{{ exit_variant }}" hidden>
  <div class="png-exit__overlay" data-exit-close></div>
  <div class="png-exit__modal" role="dialog" aria-modal="true" aria-labelledby="png-exit-heading">
    <button class="png-exit__close" type="button" data-exit-close aria-label="Close">&times;</button>

    {%- if exit_variant == 'free-proof' -%}
      {%- comment -%} Quote-first variant: free-proof CTA that opens the quote modal {%- endcomment -%}
      <div class="png-exit__text png-exit__text--proof">
        <span class="png-exit__proof-eyebrow">Free · No Charge · No Commitment</span>
        <h2 id="png-exit-heading" class="png-exit__heading">Before you go — get a free proof.</h2>
        <p class="png-exit__sub png-exit__sub--proof">
          Send us your logo and we'll mock up exactly what your <strong>{{ product.title }}</strong> will look like — back to you in 24 business hours. Nothing prints without your approval.
        </p>
      </div>

      <ul class="png-exit__proof-trust">
        <li><span class="png-exit__check" aria-hidden="true">✓</span> Free digital proof, every time</li>
        <li><span class="png-exit__check" aria-hidden="true">✓</span> 5-day delivery, guaranteed</li>
        <li><span class="png-exit__check" aria-hidden="true">✓</span> 4.8★ · 19 Google reviews</li>
      </ul>

      <button
        type="button"
        class="png-exit__cta"
        data-quote-modal-trigger
        data-product-handle="{{ product.handle }}"
        data-product-title="{{ product.title | escape }}"
        data-product-type="{{ product.type | escape }}"
        data-png-source="exit-intent"
        data-exit-close
      >
        Get a free proof &rarr;
      </button>
      <button class="png-exit__dismiss" type="button" data-exit-close>No thanks, I'll keep browsing</button>

    {%- else -%}
      {%- comment -%} Default bundle variant: collection pages + checkout-first products {%- endcomment -%}
      <div class="png-exit__images">
        {%- if tent_product.featured_image -%}
          {{ tent_product.featured_image | image_url: width: 200 | image_tag: class: 'png-exit__img', loading: 'lazy', alt: '10ft Event Tent', widths: '100,200', sizes: '100px' }}
        {%- else -%}
          <div class="png-exit__img png-exit__img--ph"></div>
        {%- endif -%}
        {%- if flag_product.featured_image -%}
          {{ flag_product.featured_image | image_url: width: 200 | image_tag: class: 'png-exit__img', loading: 'lazy', alt: 'Teardrop Flag', widths: '100,200', sizes: '100px' }}
        {%- else -%}
          <div class="png-exit__img png-exit__img--ph"></div>
        {%- endif -%}
        {%- if throw_product.featured_image -%}
          {{ throw_product.featured_image | image_url: width: 200 | image_tag: class: 'png-exit__img', loading: 'lazy', alt: 'Table Cover', widths: '100,200', sizes: '100px' }}
        {%- else -%}
          <div class="png-exit__img png-exit__img--ph"></div>
        {%- endif -%}
      </div>

      <div class="png-exit__text">
        <p class="png-exit__eyebrow">Before you go &mdash;</p>
        <h2 id="png-exit-heading" class="png-exit__heading">Bundle and save 15%</h2>
        <p class="png-exit__sub">Tent + flag + table throw. One order. 5-day delivery.</p>
      </div>

      <div class="png-exit__price">
        <p class="png-exit__price-main">Starting at $910</p>
        <p class="png-exit__price-savings">(saves you $160+)</p>
      </div>

      <a href="/collections/bundles" class="png-exit__cta">View bundles &mdash; save 15%</a>
      <button class="png-exit__dismiss" type="button" data-exit-close>No thanks, I'll keep browsing</button>
    {%- endif -%}
  </div>
</div>

<style>
  .png-exit {
    position: fixed;
    inset: 0;
    z-index: 9999;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.2s ease;
  }
  .png-exit:not([hidden]) {
    opacity: 1;
    pointer-events: auto;
  }
  .png-exit__overlay {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    cursor: pointer;
  }
  .png-exit__modal {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%) scale(0.95);
    background: #fff;
    border-radius: 12px;
    padding: 28px;
    max-width: 420px;
    width: calc(100% - 32px);
    max-height: calc(100vh - 32px);
    overflow-y: auto;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.18);
    transition: transform 0.2s ease;
  }
  .png-exit:not([hidden]) .png-exit__modal {
    transform: translate(-50%, -50%) scale(1);
  }
  .png-exit__close {
    position: absolute;
    top: 12px;
    right: 16px;
    background: none;
    border: none;
    padding: 0;
    color: #ccc;
    font-size: 18px;
    line-height: 1;
    cursor: pointer;
  }
  .png-exit__close:hover {
    color: #666;
  }
  .png-exit__images {
    display: flex;
    gap: 10px;
    justify-content: center;
    margin: 4px 0 18px;
  }
  .png-exit__img {
    width: 100px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 6px;
    display: block;
  }
  .png-exit__img--ph {
    background: #f5f5f5;
    border: 0.5px solid #eee;
  }
  .png-exit__text {
    text-align: center;
    margin-bottom: 16px;
  }
  .png-exit__eyebrow {
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 400;
    color: #999;
    margin: 0 0 6px;
  }
  .png-exit__heading {
    font-family: 'DM Serif Display', Georgia, serif;
    font-size: 24px;
    font-weight: 400;
    color: #1B2838;
    margin: 0 0 8px;
    line-height: 1.2;
  }
  .png-exit__sub {
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
    font-size: 13px;
    color: #6C757D;
    margin: 0;
    line-height: 1.5;
  }
  .png-exit__price {
    background: #F7F7F5;
    border-radius: 8px;
    padding: 12px 16px;
    text-align: center;
    margin-bottom: 16px;
  }
  .png-exit__price-main {
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
    font-size: 18px;
    font-weight: 500;
    color: #1B2838;
    margin: 0 0 2px;
  }
  .png-exit__price-savings {
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
    font-size: 12px;
    color: #1E6B4A;
    margin: 0;
  }
  .png-exit__cta {
    display: block;
    width: 100%;
    box-sizing: border-box;
    background: #C17A3A;
    color: #fff;
    padding: 14px;
    border-radius: 5px;
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
    font-size: 14px;
    font-weight: 500;
    text-align: center;
    text-decoration: none;
    transition: background-color 0.15s ease;
    margin-bottom: 12px;
  }
  .png-exit__cta:hover {
    background: #A8682F;
    color: #fff;
  }
  .png-exit__dismiss {
    display: block;
    width: 100%;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    font-family: 'DM Sans', system-ui, -apple-system, sans-serif;
    font-size: 12px;
    color: #999;
    text-align: center;
  }
  .png-exit__dismiss:hover {
    color: #666;
  }
  @media (max-width: 480px) {
    .png-exit__modal { padding: 24px 20px; }
    .png-exit__heading { font-size: 22px; }
    .png-exit__img { width: 80px; }
  }

  /* Quote-first variant: free-proof CTA */
  .png-exit__text--proof { text-align: center; margin: 0 0 18px; }
  .png-exit__proof-eyebrow {
    display: inline-block;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #1E6B4A;
    margin: 4px 0 14px;
  }
  .png-exit__sub--proof { color: #495057; line-height: 1.55; }
  .png-exit__sub--proof strong { color: #1B2838; }
  .png-exit__proof-trust {
    list-style: none;
    padding: 0;
    margin: 0 0 18px;
    text-align: left;
    background: #F7F7F5;
    border-radius: 8px;
    padding: 14px 16px;
  }
  .png-exit__proof-trust li {
    font-size: 13px;
    line-height: 1.6;
    color: #1B2838;
    display: flex;
    align-items: flex-start;
    gap: 8px;
  }
  .png-exit__proof-trust li + li { margin-top: 4px; }
  .png-exit__check {
    color: #1E6B4A;
    font-weight: 700;
    flex: 0 0 14px;
  }
</style>

<script>
(function () {
  'use strict';
  var SESSION_KEY = 'png_exit_shown';
  var PAGE_DELAY = 5000;       /* ms before detection is armed */
  var MOBILE_BP = 768;         /* mobile breakpoint */
  var MOBILE_DELTA = 100;      /* px upward in window */
  var MOBILE_WINDOW = 300;     /* ms window for measuring scroll velocity */

  /* Defensive bails (Liquid already gated, but belt + suspenders) */
  if (sessionStorage.getItem(SESSION_KEY)) return;
  var path = window.location.pathname;
  if (path === '/' || path === '') return;
  if (path.indexOf('/cart') === 0 || path.indexOf('/checkout') === 0) return;
  if (path.indexOf('/account') === 0) return;

  var popup = document.getElementById('png-exit-popup');
  if (!popup) return;

  var armed = false;
  var triggered = false;

  function show() {
    if (triggered) return;
    if (sessionStorage.getItem(SESSION_KEY)) return;
    triggered = true;
    sessionStorage.setItem(SESSION_KEY, '1');
    popup.hidden = false;
    document.body.style.overflow = 'hidden';
  }

  function close() {
    popup.hidden = true;
    document.body.style.overflow = '';
  }

  popup.querySelectorAll('[data-exit-close]').forEach(function (el) {
    el.addEventListener('click', close);
  });

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape' && !popup.hidden) close();
  });

  /* Arm detection after page-delay */
  setTimeout(function () { armed = true; }, PAGE_DELAY);

  /* Desktop: cursor leaves the document through the top */
  document.addEventListener('mouseout', function (e) {
    if (!armed || triggered) return;
    if (window.innerWidth < MOBILE_BP) return;
    /* Only fire when leaving the viewport entirely */
    if (e.relatedTarget || e.toElement) return;
    if (e.clientY < 10) show();
  });

  /* Mobile: rapid upward scroll near top */
  if (window.innerWidth < MOBILE_BP) {
    var samples = [];
    window.addEventListener('scroll', function () {
      if (!armed || triggered) return;
      var now = Date.now();
      var y = window.scrollY;
      /* Keep only samples within the time window */
      samples = samples.filter(function (s) { return now - s.t < MOBILE_WINDOW; });
      samples.push({ t: now, y: y });
      if (samples.length < 2) return;
      var startY = samples[0].y;
      var deltaUp = startY - y; /* positive = moved upward */
      if (deltaUp > MOBILE_DELTA && y < 200) {
        show();
      }
    }, { passive: true });
  }
})();
</script>
{%- endif -%}
