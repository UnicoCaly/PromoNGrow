{% comment %}
  Promo & Grow: 5-item navigation with benefit subtitles.
  Subtitles are configurable via the Header section schema in theme customizer.
{% endcomment %}

<nav class="header__inline-menu">
  <ul class="png-nav list-menu list-menu--inline" role="list">
    <!-- 1. Bundles -->
    <li>
      <a href="/collections/bundles" class="png-nav-link header__menu-item list-menu__item link link--text focus-inset">
        <span class="png-nav-item-wrap">
          <span class="png-nav-title">Bundles</span>
          <span class="png-nav-subtitle png-nav-subtitle--copper">{{ section.settings.nav_subtitle_1 | default: 'Save 15%+' }}</span>
        </span>
      </a>
    </li>
    <!-- 2. Tents -->
    <li>
      <a href="/collections/tents-canopies" class="png-nav-link header__menu-item list-menu__item link link--text focus-inset">
        <span class="png-nav-item-wrap">
          <span class="png-nav-title">Tents</span>
          <span class="png-nav-subtitle">{{ section.settings.nav_subtitle_2 | default: 'Free 3D preview' }}</span>
        </span>
      </a>
    </li>
    <!-- 3. Displays -->
    <li>
      <a href="/collections/backdrop-display" class="png-nav-link header__menu-item list-menu__item link link--text focus-inset">
        <span class="png-nav-item-wrap">
          <span class="png-nav-title">Displays</span>
          <span class="png-nav-subtitle">{{ section.settings.nav_subtitle_3 | default: 'SEG + popup' }}</span>
        </span>
      </a>
    </li>
    <!-- 4. Flags -->
    <li>
      <a href="/collections/flags" class="png-nav-link header__menu-item list-menu__item link link--text focus-inset">
        <span class="png-nav-item-wrap">
          <span class="png-nav-title">Flags</span>
          <span class="png-nav-subtitle">{{ section.settings.nav_subtitle_4 | default: '5 styles · small → large' }}</span>
        </span>
      </a>
    </li>
    <!-- 5. Wraps -->
    <li>
      <a href="/collections/wraps" class="png-nav-link header__menu-item list-menu__item link link--text focus-inset">
        <span class="png-nav-item-wrap">
          <span class="png-nav-title">Wraps</span>
          <span class="png-nav-subtitle">{{ section.settings.nav_subtitle_5 | default: 'Walls + backdrops' }}</span>
        </span>
      </a>
    </li>
    <!-- 6. More (dropdown of remaining collections) -->
    {%- liquid
      assign main_handles = 'bundles,tents-canopies,backdrop-display,flags,wraps,frontpage,all' | split: ','
      assign extra_collections = ''
      for col in collections
        unless main_handles contains col.handle
          assign extra_collections = extra_collections | append: col.handle | append: '|'
        endunless
      endfor
    -%}
    {%- if extra_collections != blank -%}
      <li class="png-nav-more">
        <details class="png-nav-more__details">
          <summary class="png-nav-link png-nav-more__summary header__menu-item list-menu__item link link--text focus-inset">
            <span class="png-nav-item-wrap">
              <span class="png-nav-title">
                {{ section.settings.nav_more_label | default: 'More' }}
                <span class="png-nav-more__caret" aria-hidden="true">&#9662;</span>
              </span>
            </span>
          </summary>
          <ul class="png-nav-more__menu" role="list">
            {%- for col in collections -%}
              {%- unless main_handles contains col.handle -%}
                <li>
                  <a href="{{ col.url }}" class="png-nav-more__link">
                    {{ col.title | escape }}
                    {%- if col.products_count > 0 -%}
                      <span class="png-nav-more__count">{{ col.products_count }}</span>
                    {%- endif -%}
                  </a>
                </li>
              {%- endunless -%}
            {%- endfor -%}
          </ul>
        </details>
      </li>
    {%- endif -%}
  </ul>
</nav>

<script>
(function () {
  /* Close the More dropdown when clicking outside or pressing Escape.
     Deferred so it doesn't compete with first paint. */
  function init() {
    var moreEl = document.querySelector('.png-nav-more__details');
    if (!moreEl) return;
    document.addEventListener('click', function (e) {
      if (!moreEl.contains(e.target)) moreEl.removeAttribute('open');
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape') moreEl.removeAttribute('open');
    });
  }
  if ('requestIdleCallback' in window) {
    requestIdleCallback(init, { timeout: 2000 });
  } else if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function () { setTimeout(init, 500); });
  } else {
    setTimeout(init, 500);
  }
})();
</script>
