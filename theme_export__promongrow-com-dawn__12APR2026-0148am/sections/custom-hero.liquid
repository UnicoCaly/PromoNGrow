<!-- Promo & Grow: Dark Navy Hero -->
<section class="png-hero-dark">
  <div class="png-hero-dark__inner">
    <div class="png-hero-dark__columns">

      <!-- Left column: text content -->
      <div class="png-hero-dark__content">
        <span class="png-hero-dark__eyebrow">{{ section.settings.eyebrow | default: 'Custom event displays' }}</span>
        <h1 class="png-hero-dark__heading">{{ section.settings.heading | default: 'Your brand, built to show up.' }}</h1>
        <p class="png-hero-dark__subtext">{{ section.settings.subtext | default: 'Custom tents, backdrops, flags, and signage — produced and delivered nationwide in 5 business days.' }}</p>
        <div class="png-hero-dark__actions">
          <a href="{{ section.settings.primary_url | default: '/collections/bundles' }}" class="png-hero-dark__btn-primary">
            {{ section.settings.primary_label | default: 'Shop bundles' }}
          </a>
          <a href="{{ section.settings.secondary_url | default: '/pages/contact' }}" class="png-hero-dark__btn-ghost">
            {{ section.settings.secondary_label | default: 'Get a quote' }}
          </a>
        </div>
      </div>

      <!-- Right column: hero image -->
      <div class="png-hero-dark__image">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 840
            | image_tag:
              class: 'png-hero-dark__img',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(max-width: 768px) 100vw, 420px',
              widths: '420, 600, 840',
              alt: section.settings.image.alt | default: shop.name
          }}
        {%- else -%}
          <div class="png-hero-dark__placeholder">
            Add hero image in theme customizer
          </div>
        {%- endif -%}
      </div>

    </div>

    <!-- Trust bar (inside the navy container) -->
    <div class="png-hero-dark__trust">
      <div class="png-hero-dark__trust-item">
        <span class="png-hero-dark__stars" aria-label="4.8 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="png-hero-dark__trust-text">4.8 from 19 Google reviews</span>
      </div>
      <span class="png-hero-dark__trust-divider" aria-hidden="true"></span>
      <span class="png-hero-dark__trust-text">20+ years in production</span>
      <span class="png-hero-dark__trust-divider" aria-hidden="true"></span>
      <span class="png-hero-dark__trust-text">Printed in the USA</span>
    </div>

  </div>
</section>

{%- comment -%} 4-Door Intent Router — embedded in hero so it always renders on the homepage {%- endcomment -%}
{%- if section.settings.show_router -%}
  {%- liquid
    assign loc = routes.root_url
    if loc == '/'
      assign loc = ''
    endif
  -%}
  <section class="png-router">
    <div class="page-width">
      {%- if section.settings.router_heading != blank -%}
        <h2 class="png-router__heading">{{ section.settings.router_heading }}</h2>
      {%- endif -%}
      {%- if section.settings.router_sub != blank -%}
        <p class="png-router__sub">{{ section.settings.router_sub }}</p>
      {%- endif -%}
      <div class="png-router__grid">

        <a href="{{ loc }}/pages/contact?intent=quote-request"
           class="png-router__door png-router__door--primary"
           data-quote-modal-trigger
           data-intent-door="free-proof">
          <span class="png-router__ic" aria-hidden="true">&#10003;</span>
          <span class="png-router__label">{{ section.settings.door1_label | default: 'Get a Free Proof' }}</span>
          <span class="png-router__sublabel">{{ section.settings.door1_sub | default: 'See it before you pay. No commitment.' }}</span>
          <span class="png-router__cta">{{ section.settings.door1_cta | default: 'Start free proof' }} &rarr;</span>
        </a>

        <a href="{{ loc }}{{ section.settings.door2_link | default: '/collections/bundles' }}"
           class="png-router__door"
           data-intent-door="bundles">
          <span class="png-router__ic" aria-hidden="true">&#9733;</span>
          <span class="png-router__label">{{ section.settings.door2_label | default: 'Shop Bundles' }}</span>
          <span class="png-router__sublabel">{{ section.settings.door2_sub | default: 'Tent + flag + throw. Save 15%+.' }}</span>
          <span class="png-router__cta">{{ section.settings.door2_cta | default: 'Build a bundle' }} &rarr;</span>
        </a>

        <a href="{{ loc }}{{ section.settings.door3_link | default: '/collections/all' }}"
           class="png-router__door"
           data-intent-door="buy-online">
          <span class="png-router__ic" aria-hidden="true">&#128722;</span>
          <span class="png-router__label">{{ section.settings.door3_label | default: 'Buy Online' }}</span>
          <span class="png-router__sublabel">{{ section.settings.door3_sub | default: 'Know what you need? Shop the catalog.' }}</span>
          <span class="png-router__cta">{{ section.settings.door3_cta | default: 'Browse all' }} &rarr;</span>
        </a>

        <a href="tel:{{ section.settings.router_phone | default: '8448833308' }}"
           class="png-router__door"
           data-intent-door="talk-to-us"
           data-png-source="intent-router">
          <span class="png-router__ic" aria-hidden="true">&#9742;</span>
          <span class="png-router__label">{{ section.settings.door4_label | default: 'Talk to Us' }}</span>
          <span class="png-router__sublabel">{{ section.settings.door4_sub | default: 'Custom job? Call and we will scope it.' }}</span>
          <span class="png-router__cta">{{ section.settings.door4_cta | default: '(844) 883-3308' }}</span>
        </a>

      </div>
    </div>
  </section>
  <script>
    (function () {
      var doors = document.querySelectorAll('.png-router [data-intent-door]');
      if (!doors.length) return;
      doors.forEach(function (d) {
        d.addEventListener('click', function () {
          try {
            window.dataLayer = window.dataLayer || [];
            var payload = { event: 'intent_door', door: d.getAttribute('data-intent-door') };
            window.dataLayer.push(payload);
            document.dispatchEvent(new CustomEvent('png:intent_door', { detail: payload }));
          } catch (e) {}
        });
      });
    })();
  </script>
{%- endif -%}

