{%- comment -%}
  Promo & Grow — AEO FAQ block for articles (Phase 2: SEO/AEO surface)

  Appends a styled FAQ accordion + FAQPage JSON-LD beneath an article's body,
  so the 1-2 FAQ/AEO articles become answer-engine eligible (Google rich
  results, AI overviews). Pairs with the standard main-article section above it.

  Add FAQ blocks in the theme editor; each becomes an accordion item AND a
  structured-data entry. A closing "Get a Free Proof" CTA routes article
  readers into the concierge bridge.
{%- endcomment -%}

{%- liquid
  assign has_faq = false
  for block in section.blocks
    if block.type == 'faq'
      assign has_faq = true
    endif
  endfor
-%}

{%- if has_faq -%}
  <div class="png-aeo page-width">
    <h2 class="png-aeo__heading">{{ section.settings.heading | default: 'Common questions' }}</h2>
    <div class="png-aeo__list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          <details class="png-aeo__item" {{ block.shopify_attributes }}>
            <summary class="png-aeo__q">
              <span>{{ block.settings.question }}</span>
              <span class="png-aeo__toggle" aria-hidden="true">+</span>
            </summary>
            <div class="png-aeo__a rte">{{ block.settings.answer }}</div>
          </details>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.show_cta -%}
      <div class="png-aeo__cta">
        <div>
          <h3 class="png-aeo__cta-h">{{ section.settings.cta_heading | default: 'Ready to see your design?' }}</h3>
          <p class="png-aeo__cta-sub">{{ section.settings.cta_sub | default: 'Send your logo. Get a free proof back — no charge, no commitment.' }}</p>
        </div>
        <a href="{{ routes.root_url }}/pages/contact?intent=quote-request"
           class="png-aeo__cta-btn"
           data-quote-modal-trigger
           data-cta="aeo-article">
          {{ section.settings.cta_label | default: 'Get a Free Proof' }} &rarr;
        </a>
      </div>
    {%- endif -%}
  </div>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    "mainEntity": [
      {%- assign first = true -%}
      {%- for block in section.blocks -%}
        {%- if block.type == 'faq' -%}
          {%- unless first %},{% endunless -%}
          {
            "@type": "Question",
            "name": {{ block.settings.question | strip_html | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.answer | strip_html | json }} }
          }
          {%- assign first = false -%}
        {%- endif -%}
      {%- endfor -%}
    ]
  }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "AEO FAQ",
  "tag": "section",
  "class": "png-aeo-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Common questions" },
    { "type": "header", "content": "Closing CTA" },
    { "type": "checkbox", "id": "show_cta", "label": "Show free-proof CTA", "default": true },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Ready to see your design?" },
    { "type": "text", "id": "cta_sub", "label": "CTA subtext", "default": "Send your logo. Get a free proof back — no charge, no commitment." },
    { "type": "text", "id": "cta_label", "label": "CTA button", "default": "Get a Free Proof" }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ item",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How fast is delivery?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Five business days from approved proof to ship — guaranteed, nationwide.</p>" }
      ]
    }
  ],
  "presets": [
    { "name": "AEO FAQ" }
  ]
}
{% endschema %}
