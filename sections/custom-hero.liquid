<!-- Promo & Grow: Dark Navy Hero -->
<section class="png-hero-dark">
  <div class="png-hero-dark__inner">
    <div class="png-hero-dark__columns">

      <!-- Left column: text content -->
      <div class="png-hero-dark__content">
        <span class="png-hero-dark__eyebrow">{{ section.settings.eyebrow | default: 'Custom event displays' }}</span>
        <h1 class="png-hero-dark__heading">{{ section.settings.heading | default: 'Your brand, built to show up.' }}</h1>
        <p class="png-hero-dark__subtext">{{ section.settings.subtext | default: 'Custom tents, backdrops, flags, and signage — produced and delivered nationwide in 5 business days.' }}</p>
        <div class="png-hero-dark__actions">
          <a href="{{ section.settings.primary_url | default: '/collections/bundles' }}" class="png-hero-dark__btn-primary">
            {{ section.settings.primary_label | default: 'Shop bundles' }}
          </a>
          <a href="{{ section.settings.secondary_url | default: '/pages/contact' }}" class="png-hero-dark__btn-ghost">
            {{ section.settings.secondary_label | default: 'Get a quote' }}
          </a>
        </div>
      </div>

      <!-- Right column: hero image -->
      <div class="png-hero-dark__image">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 840
            | image_tag:
              class: 'png-hero-dark__img',
              loading: 'eager',
              fetchpriority: 'high',
              sizes: '(max-width: 768px) 100vw, 420px',
              widths: '420, 600, 840',
              alt: section.settings.image.alt | default: shop.name
          }}
        {%- else -%}
          <div class="png-hero-dark__placeholder">
            Add hero image in theme customizer
          </div>
        {%- endif -%}
      </div>

    </div>

    <!-- Trust bar (inside the navy container) -->
    <div class="png-hero-dark__trust">
      <div class="png-hero-dark__trust-item">
        <span class="png-hero-dark__stars" aria-label="4.8 out of 5 stars">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <span class="png-hero-dark__trust-text">4.8 from 19 Google reviews</span>
      </div>
      <span class="png-hero-dark__trust-divider" aria-hidden="true"></span>
      <span class="png-hero-dark__trust-text">20+ years in production</span>
      <span class="png-hero-dark__trust-divider" aria-hidden="true"></span>
      <span class="png-hero-dark__trust-text">Printed in the USA</span>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "class": "png-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "Custom event displays"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Your brand, built to show up."
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Custom tents, backdrops, flags, and signage — produced and delivered nationwide in 5 business days."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary CTA text",
      "default": "Shop bundles"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary CTA link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary CTA text",
      "default": "Get a quote"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary CTA link"
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
