<!-- Promo & Grow: Dynamic Bundle Builder (JS-powered) -->
{%- comment -%}
  Renders only on the Bundles collection (handle "bundles") OR when force_show is true.
  All product data is fetched live from Shopify's AJAX API on page load.
  Bundle config lives in the JSON script block below — easy to edit, no Liquid logic needed.
{%- endcomment -%}

{%- if collection.handle == 'bundles' or section.settings.force_show -%}
<section class="png-bb-section" data-bundle-builder>
  <div class="page-width">

    <span class="png-eyebrow">{{ section.settings.eyebrow | default: 'Build your bundle' }}</span>
    <h2 class="png-bb-section__heading">{{ section.settings.heading | default: 'Pick a bundle. Save 15%.' }}</h2>

    <!-- Bundle config: JS reads this on load -->
    <script type="application/json" data-bundle-config>
    {
      "discount": 0.15,
      "bundles": [
        {
          "id": "event-vendor",
          "name": "Event Vendor",
          "popular": false,
          "items": [
            { "type": "choice", "slot": "tent", "label": "Tent Size", "options": [
              { "handle": "10ft-x-10ft-event-tent-canopy", "label": "10ft x 10ft Event Tent" },
              { "handle": "10-x-15-event-tent", "label": "10ft x 15ft Event Tent" },
              { "handle": "10ft-x-20ft-event-tent-canopy", "label": "10ft x 20ft Event Tent" }
            ] },
            { "type": "choice", "slot": "banner", "label": "Banner", "options": [
              { "handle": "banner-4ft-x-10ft", "label": "Tent Banner — 4ft x 10ft" }
            ] },
            { "type": "choice", "slot": "throw", "label": "Table Throw", "options": [
              { "handle": "stretch-table-cover", "label": "Stretch Table Cover" },
              { "handle": "8ft-table-throw", "label": "Table Throw" },
              { "handle": "6ft-table-runner-with-solid-blank-table-throw", "label": "Table Runner + Blank" }
            ] }
          ]
        },
        {
          "id": "event-pro",
          "name": "Event Pro",
          "popular": true,
          "items": [
            { "type": "choice", "slot": "tent", "label": "Tent Size", "options": [
              { "handle": "10ft-x-10ft-event-tent-canopy", "label": "10ft x 10ft Event Tent" },
              { "handle": "10-x-15-event-tent", "label": "10ft x 15ft Event Tent" },
              { "handle": "10ft-x-20ft-event-tent-canopy", "label": "10ft x 20ft Event Tent" }
            ] },
            { "type": "choice", "slot": "flag", "label": "Flag (size + qty)", "qtyMax": 4, "variants": true, "options": [
              { "handle": "feather-convex-flag", "label": "Feather Convex Flag" },
              { "handle": "rectangle-flag", "label": "Rectangle Flag" },
              { "handle": "feather-angled-flag", "label": "Feather Angled Flag" },
              { "handle": "econo-feather-flag", "label": "Econo Feather Flag" }
            ] },
            { "type": "choice", "slot": "throw", "label": "Table Throw", "options": [
              { "handle": "stretch-table-cover", "label": "Stretch Table Cover" },
              { "handle": "8ft-table-throw", "label": "Table Throw" },
              { "handle": "6ft-table-runner-with-solid-blank-table-throw", "label": "Table Runner + Blank" }
            ] }
          ]
        },
        {
          "id": "trade-show-starter",
          "name": "Trade Show Starter",
          "popular": false,
          "items": [
            { "type": "choice", "slot": "display", "label": "Display", "options": [
              { "handle": "straight-velcro-fabric-pop-up-display", "label": "Straight Tension Fabric Display" }
            ] },
            { "type": "choice", "slot": "backdrop", "label": "Backdrop", "options": [
              { "handle": "pillowcase-backdrop-fabric-tension-display", "label": "Pillowcase Backdrop" }
            ] }
          ]
        }
      ]
    }
    </script>

    <!-- Bundle cards -->
    <div class="png-bb__grid">

      <!-- Card 1: Event Vendor -->
      <article class="png-bb__card" data-bundle-id="event-vendor">
        <span class="png-bb__name">Event Vendor</span>
        <h3 class="png-bb__title">Booth-ready in 5 days</h3>
        <div class="png-bb__items" data-bundle-items></div>
        <div class="png-bb__pricing" data-bundle-pricing>
          <span class="png-bb__regular" data-bundle-regular>—</span>
          <span class="png-bb__bundle-price" data-bundle-price>—</span>
          <span class="png-bb__savings" data-bundle-savings></span>
        </div>
        <button type="button" class="png-bb__add" data-bundle-add disabled>
          <span data-bundle-btn-text>Loading bundle...</span>
        </button>
      </article>

      <!-- Card 2: Event Pro (popular) -->
      <article class="png-bb__card png-bb__card--popular" data-bundle-id="event-pro">
        <span class="png-bb__popular-badge">Most popular</span>
        <span class="png-bb__name">Event Pro</span>
        <h3 class="png-bb__title">Customize every piece</h3>
        <div class="png-bb__items" data-bundle-items></div>
        <div class="png-bb__pricing" data-bundle-pricing>
          <span class="png-bb__regular" data-bundle-regular>—</span>
          <span class="png-bb__bundle-price" data-bundle-price>—</span>
          <span class="png-bb__savings" data-bundle-savings></span>
        </div>
        <button type="button" class="png-bb__add" data-bundle-add disabled>
          <span data-bundle-btn-text>Loading bundle...</span>
        </button>
      </article>

      <!-- Card 3: Trade Show Starter -->
      <article class="png-bb__card" data-bundle-id="trade-show-starter">
        <span class="png-bb__name">Trade Show Starter</span>
        <h3 class="png-bb__title">Backdrop-first setup</h3>
        <div class="png-bb__items" data-bundle-items></div>
        <div class="png-bb__pricing" data-bundle-pricing>
          <span class="png-bb__regular" data-bundle-regular>—</span>
          <span class="png-bb__bundle-price" data-bundle-price>—</span>
          <span class="png-bb__savings" data-bundle-savings></span>
        </div>
        <button type="button" class="png-bb__add" data-bundle-add disabled>
          <span data-bundle-btn-text>Loading bundle...</span>
        </button>
      </article>

    </div>

    <!-- Custom Bundle CTA -->
    <div class="png-bb__custom-cta">
      <div class="png-bb__custom-cta-text">
        <h3 class="png-bb__custom-cta-heading">Need something different?</h3>
        <p class="png-bb__custom-cta-subtext">We build custom bundles for any event. Tell us what you need.</p>
      </div>
      <div class="png-bb__custom-cta-actions">
        <a href="/pages/contact" class="png-btn-primary">Get a quote</a>
        <a href="tel:8448833308" class="png-bb__custom-cta-ghost">(844) 883-3308</a>
      </div>
    </div>

  </div>
</section>

<script>
(function () {
  'use strict';

  var root = document.querySelector('[data-bundle-builder]');
  if (!root) return;

  /* --- Read bundle config --- */
  var configEl = root.querySelector('[data-bundle-config]');
  if (!configEl) return;
  var config;
  try {
    config = JSON.parse(configEl.textContent);
  } catch (e) {
    console.error('[bundle-builder] Invalid config JSON', e);
    return;
  }

  var DISCOUNT = config.discount || 0.15;

  /* --- Product cache --- */
  var productCache = {};
  var productPromises = {};

  function fetchProduct(handle) {
    if (productPromises[handle]) return productPromises[handle];
    productPromises[handle] = fetch('/products/' + encodeURIComponent(handle) + '.json')
      .then(function (r) {
        if (!r.ok) throw new Error('Product not found: ' + handle);
        return r.json();
      })
      .then(function (data) {
        var p = data.product;
        if (!p) throw new Error('Empty product: ' + handle);
        var firstAvailable = (p.variants || []).find(function (v) { return v.available; }) || p.variants[0];
        if (!firstAvailable) throw new Error('No variants: ' + handle);
        var thumb = '';
        if (p.image && p.image.src) thumb = p.image.src;
        else if (p.images && p.images[0]) thumb = p.images[0].src;
        var variants = (p.variants || []).map(function (v) {
          return { id: v.id, title: v.title, price: toCents(v.price), available: !!v.available };
        });
        productCache[handle] = {
          handle: handle,
          title: p.title,
          variantId: firstAvailable.id,
          price: toCents(firstAvailable.price),
          variants: variants,
          thumb: thumb,
          available: firstAvailable.available
        };
        return productCache[handle];
      })
      .catch(function (err) {
        console.warn('[bundle-builder] ' + err.message);
        productCache[handle] = null;
        return null;
      });
    return productPromises[handle];
  }

  /* --- Money formatter --- */
  function formatMoney(cents) {
    if (cents == null || isNaN(cents)) return '—';
    var dollars = cents / 100;
    return '$' + dollars.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  /* --- Price (storefront dollars string) → integer cents --- */
  function toCents(price) {
    var c = Math.round(parseFloat(price) * 100);
    return isNaN(c) ? 0 : c;
  }

  /* --- Build <option>s for a product's variants (size / options) --- */
  function variantOptionsHtml(product, selectedId) {
    if (!product || !product.variants) return '';
    return product.variants.map(function (v) {
      var dis = v.available ? '' : ' disabled';
      var selAttr = (selectedId && v.id === selectedId) ? ' selected' : '';
      return '<option value="' + v.id + '"' + dis + selAttr + '>' +
        escapeHtml(v.title) + ' — ' + formatMoney(v.price) +
      '</option>';
    }).join('');
  }

  /* --- Unit price (cents) for the currently-selected variant, else product default --- */
  function unitPriceFor(product, variantSel) {
    if (!product) return null;
    if (variantSel && variantSel.value && product.variants && product.variants.length) {
      var vid = parseInt(variantSel.value, 10);
      for (var i = 0; i < product.variants.length; i++) {
        if (product.variants[i].id === vid) return product.variants[i].price;
      }
    }
    return product.price;
  }

  /* --- Render a fixed item row --- */
  function renderFixedRow(item, product) {
    var row = document.createElement('div');
    row.className = 'png-bb__item';
    row.setAttribute('data-handle', item.handle);
    if (!product) {
      row.classList.add('png-bb__item--error');
      row.innerHTML =
        '<div class="png-bb__thumb png-bb__thumb--ph"></div>' +
        '<div class="png-bb__item-info">' +
          '<span class="png-bb__item-title">' + escapeHtml(item.label) + '</span>' +
          '<span class="png-bb__item-badge">Included</span>' +
        '</div>' +
        '<span class="png-bb__item-price">Price unavailable</span>';
      return row;
    }
    var thumbHtml = product.thumb
      ? '<img class="png-bb__thumb" src="' + buildThumbUrl(product.thumb) + '" alt="' + escapeHtml(product.title) + '" loading="lazy" decoding="async" width="40" height="40">'
      : '<div class="png-bb__thumb png-bb__thumb--ph"></div>';
    row.innerHTML =
      thumbHtml +
      '<div class="png-bb__item-info">' +
        '<span class="png-bb__item-title">' + escapeHtml(product.title) + '</span>' +
        '<span class="png-bb__item-badge">Included</span>' +
      '</div>' +
      '<span class="png-bb__item-price">' + formatMoney(product.price) + '</span>';
    return row;
  }

  /* --- Render a choice (dropdown) row --- */
  function renderChoiceRow(item, products, bundleId) {
    var row = document.createElement('div');
    row.className = 'png-bb__item png-bb__item--choice';
    row.setAttribute('data-slot', item.slot);

    var firstValid = products.find(function (p) { return p; });
    var thumb = firstValid && firstValid.thumb
      ? '<img class="png-bb__thumb" data-choice-thumb src="' + buildThumbUrl(firstValid.thumb) + '" alt="' + escapeHtml(firstValid.title || item.label) + '" loading="lazy" decoding="async" width="40" height="40">'
      : '<div class="png-bb__thumb png-bb__thumb--ph" data-choice-thumb></div>';

    var optionsHtml = item.options.map(function (opt, i) {
      var p = products[i];
      var priceLabel = p ? ' — ' + formatMoney(p.price) : ' — unavailable';
      var disabled = p ? '' : ' disabled';
      return '<option value="' + escapeHtml(opt.handle) + '"' + disabled + '>' +
        escapeHtml(opt.label) + priceLabel +
      '</option>';
    }).join('');

    /* Optional size/variant selector — shown when the slot opts in with "variants": true */
    var variantHtml = '';
    if (item.variants === true) {
      variantHtml =
        '<select class="png-bb__select png-bb__select--variant" data-choice-variant data-slot="' + escapeHtml(item.slot) + '" aria-label="Size and options for ' + escapeHtml(item.label) + '">' +
          (firstValid ? variantOptionsHtml(firstValid, firstValid.variantId) : '') +
        '</select>';
    }

    /* Optional quantity selector (e.g. add multiple flags) — shown only when qtyMax > 1 */
    var qtyHtml = '';
    var qtyMax = parseInt(item.qtyMax, 10);
    if (qtyMax && qtyMax > 1) {
      var qtyOptions = '';
      for (var q = 1; q <= qtyMax; q++) {
        qtyOptions += '<option value="' + q + '">Qty: ' + q + '</option>';
      }
      qtyHtml =
        '<select class="png-bb__select png-bb__select--qty" data-choice-qty data-slot="' + escapeHtml(item.slot) + '" aria-label="Quantity for ' + escapeHtml(item.label) + '">' +
          qtyOptions +
        '</select>';
    }

    row.innerHTML =
      thumb +
      '<div class="png-bb__item-info">' +
        '<span class="png-bb__item-label">' + escapeHtml(item.label) + '</span>' +
        '<select class="png-bb__select" data-choice-select data-bundle="' + escapeHtml(bundleId) + '" data-slot="' + escapeHtml(item.slot) + '">' +
          optionsHtml +
        '</select>' +
        variantHtml +
        qtyHtml +
      '</div>' +
      '<span class="png-bb__item-price" data-choice-price>' + (firstValid ? formatMoney(firstValid.price) : '—') + '</span>';
    return row;
  }

  /* --- Build smaller thumbnail URL for performance --- */
  function buildThumbUrl(src) {
    if (!src) return '';
    /* Insert _80x80 size hint before extension if pattern matches */
    return src.replace(/(\.(jpe?g|png|webp|gif))(\?|$)/i, '_80x80$1$3');
  }

  /* --- Escape HTML --- */
  function escapeHtml(str) {
    if (str == null) return '';
    return String(str).replace(/[&<>"']/g, function (c) {
      return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
    });
  }

  /* --- Calculate bundle totals --- */
  function calculateBundle(card, bundleConfig) {
    var total = 0;
    var allValid = true;
    var lines = [];

    /* Aggregate by variant so the same item picked twice merges into one line */
    function addLine(variantId, qty) {
      for (var i = 0; i < lines.length; i++) {
        if (lines[i].id === variantId) { lines[i].quantity += qty; return; }
      }
      lines.push({ id: variantId, quantity: qty });
    }

    bundleConfig.items.forEach(function (item) {
      if (item.type === 'fixed') {
        var p = productCache[item.handle];
        if (!p) { allValid = false; return; }
        var fq = parseInt(item.qty, 10) > 0 ? parseInt(item.qty, 10) : 1;
        total += p.price * fq;
        addLine(p.variantId, fq);
      } else if (item.type === 'choice') {
        var sel = card.querySelector('[data-choice-select][data-slot="' + item.slot + '"]');
        if (!sel) return;
        var cp = productCache[sel.value];
        if (!cp) { allValid = false; return; }
        var variantSel = card.querySelector('[data-choice-variant][data-slot="' + item.slot + '"]');
        var variantId = (variantSel && variantSel.value) ? (parseInt(variantSel.value, 10) || cp.variantId) : cp.variantId;
        var unit = unitPriceFor(cp, variantSel);
        var qtySel = card.querySelector('[data-choice-qty][data-slot="' + item.slot + '"]');
        var qty = qtySel ? (parseInt(qtySel.value, 10) || 1) : 1;
        total += (unit || 0) * qty;
        addLine(variantId, qty);
      }
    });

    return { total: total, lines: lines, valid: allValid };
  }

  /* --- Update pricing display for a card --- */
  function updateCardPricing(card, bundleConfig) {
    var calc = calculateBundle(card, bundleConfig);
    var regularEl = card.querySelector('[data-bundle-regular]');
    var priceEl = card.querySelector('[data-bundle-price]');
    var savingsEl = card.querySelector('[data-bundle-savings]');
    var btn = card.querySelector('[data-bundle-add]');
    var btnText = card.querySelector('[data-bundle-btn-text]');

    if (!calc.valid || calc.total === 0) {
      regularEl.textContent = 'Price unavailable';
      priceEl.textContent = '';
      savingsEl.textContent = '';
      if (btn) btn.disabled = true;
      if (btnText) btnText.textContent = 'Unavailable';
      return;
    }

    var bundlePrice = Math.round(calc.total * (1 - DISCOUNT));
    var savings = calc.total - bundlePrice;

    regularEl.textContent = 'Regular: ' + formatMoney(calc.total);
    priceEl.textContent = 'Bundle: ' + formatMoney(bundlePrice);
    savingsEl.textContent = 'Save ' + formatMoney(savings) + ' (' + Math.round(DISCOUNT * 100) + '%)';

    if (btn) btn.disabled = false;
    if (btnText) btnText.textContent = 'Add bundle to cart';

    /* Stash line items (variant id + quantity) on the button for the add handler */
    btn.setAttribute('data-lines', JSON.stringify(calc.lines));
  }

  /* --- Update choice price + thumb when dropdown changes --- */
  function handleChoiceChange(card, bundleConfig, sel) {
    var slot = sel.getAttribute('data-slot');
    var row = sel.closest('.png-bb__item');
    var priceEl = row.querySelector('[data-choice-price]');
    var thumbEl = row.querySelector('[data-choice-thumb]');
    var qtySel = row.querySelector('[data-choice-qty]');
    var variantSel = row.querySelector('[data-choice-variant]');
    var qty = qtySel ? (parseInt(qtySel.value, 10) || 1) : 1;
    var p = productCache[sel.value];
    var unit = unitPriceFor(p, variantSel);

    if (priceEl) priceEl.textContent = (unit != null) ? formatMoney(unit * qty) : '—';
    if (thumbEl && p && p.thumb) {
      var newThumb;
      if (thumbEl.tagName === 'IMG') {
        thumbEl.src = buildThumbUrl(p.thumb);
        thumbEl.alt = p.title || '';
      } else {
        newThumb = document.createElement('img');
        newThumb.className = 'png-bb__thumb';
        newThumb.setAttribute('data-choice-thumb', '');
        newThumb.src = buildThumbUrl(p.thumb);
        newThumb.alt = p.title || '';
        newThumb.loading = 'lazy';
        newThumb.decoding = 'async';
        newThumb.width = 40;
        newThumb.height = 40;
        thumbEl.replaceWith(newThumb);
      }
    }

    updateCardPricing(card, bundleConfig);
  }

  /* --- Add to cart --- */
  function handleAddToCart(card, bundleConfig) {
    var btn = card.querySelector('[data-bundle-add]');
    var btnText = card.querySelector('[data-bundle-btn-text]');
    if (!btn || btn.disabled) return;

    var lines;
    try { lines = JSON.parse(btn.getAttribute('data-lines') || '[]'); } catch (e) { lines = []; }
    if (!lines.length) return;

    var originalText = btnText.textContent;
    btn.disabled = true;
    btnText.textContent = 'Adding...';

    var items = lines.map(function (ln) {
      return {
        id: ln.id,
        quantity: ln.quantity || 1,
        properties: { '_bundle': bundleConfig.name }
      };
    });

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: items })
    })
      .then(function (r) {
        if (!r.ok) throw new Error('Cart add failed');
        return r.json();
      })
      .then(function () {
        btnText.textContent = '✓ Added!';
        updateCartCount();
        document.dispatchEvent(new CustomEvent('cart:item-added', {
          detail: { bundle: bundleConfig.name, count: items.length }
        }));
        setTimeout(function () {
          btnText.textContent = originalText;
          btn.disabled = false;
        }, 2000);
      })
      .catch(function (err) {
        console.error('[bundle-builder] Cart add failed', err);
        btnText.textContent = 'Try again';
        setTimeout(function () {
          btnText.textContent = originalText;
          btn.disabled = false;
        }, 2500);
      });
  }

  /* --- Update header cart count bubble --- */
  function updateCartCount() {
    fetch('/cart.js', { headers: { 'Accept': 'application/json' } })
      .then(function (r) { return r.json(); })
      .then(function (cart) {
        var bubble = document.querySelector('#cart-icon-bubble .cart-count-bubble');
        var emptyIcon = document.querySelector('#cart-icon-bubble .icon-cart-empty');
        if (cart.item_count > 0) {
          if (bubble) {
            var span = bubble.querySelector('span[aria-hidden]');
            if (span) span.textContent = cart.item_count < 100 ? cart.item_count : '99+';
          } else {
            /* Bubble doesn't exist yet — create one */
            var iconWrap = document.querySelector('#cart-icon-bubble');
            if (iconWrap) {
              var newBubble = document.createElement('div');
              newBubble.className = 'cart-count-bubble';
              newBubble.innerHTML = '<span aria-hidden="true">' + cart.item_count + '</span>' +
                '<span class="visually-hidden">' + cart.item_count + ' items</span>';
              iconWrap.appendChild(newBubble);
            }
          }
        }
      })
      .catch(function () { /* silent */ });
  }

  /* --- Hydrate a single bundle card --- */
  function hydrateBundle(bundleConfig) {
    var card = root.querySelector('.png-bb__card[data-bundle-id="' + bundleConfig.id + '"]');
    if (!card) return;

    /* Collect handles to fetch */
    var handles = [];
    bundleConfig.items.forEach(function (item) {
      if (item.type === 'fixed') {
        handles.push(item.handle);
      } else if (item.type === 'choice') {
        item.options.forEach(function (opt) { handles.push(opt.handle); });
      }
    });

    Promise.all(handles.map(fetchProduct)).then(function () {
      /* Build item rows */
      var itemsContainer = card.querySelector('[data-bundle-items]');
      itemsContainer.innerHTML = '';

      bundleConfig.items.forEach(function (item) {
        if (item.type === 'fixed') {
          var p = productCache[item.handle];
          itemsContainer.appendChild(renderFixedRow(item, p));
        } else if (item.type === 'choice') {
          var products = item.options.map(function (opt) { return productCache[opt.handle]; });
          itemsContainer.appendChild(renderChoiceRow(item, products, bundleConfig.id));
        }
      });

      /* Wire up product (type) dropdown listeners — repopulate the size/variant dropdown on change */
      card.querySelectorAll('[data-choice-select]').forEach(function (sel) {
        sel.addEventListener('change', function () {
          var srow = sel.closest('.png-bb__item');
          var vsel = srow ? srow.querySelector('[data-choice-variant]') : null;
          var sp = productCache[sel.value];
          if (vsel && sp) vsel.innerHTML = variantOptionsHtml(sp, sp.variantId);
          handleChoiceChange(card, bundleConfig, sel);
        });
      });

      /* Wire up size/variant dropdown listeners */
      card.querySelectorAll('[data-choice-variant]').forEach(function (vsel) {
        vsel.addEventListener('change', function () {
          var vrow = vsel.closest('.png-bb__item');
          var psel = vrow ? vrow.querySelector('[data-choice-select]') : null;
          if (psel) handleChoiceChange(card, bundleConfig, psel);
          else updateCardPricing(card, bundleConfig);
        });
      });

      /* Wire up quantity listeners (e.g. multiple flags) */
      card.querySelectorAll('[data-choice-qty]').forEach(function (qsel) {
        qsel.addEventListener('change', function () {
          var qrow = qsel.closest('.png-bb__item');
          var psel = qrow ? qrow.querySelector('[data-choice-select]') : null;
          if (psel) handleChoiceChange(card, bundleConfig, psel);
          else updateCardPricing(card, bundleConfig);
        });
      });

      /* Initial pricing */
      updateCardPricing(card, bundleConfig);

      /* Wire up add-to-cart */
      var btn = card.querySelector('[data-bundle-add]');
      btn.addEventListener('click', function () {
        handleAddToCart(card, bundleConfig);
      });
    });
  }

  /* --- Init: defer hydration so first paint isn't blocked --- */
  function startHydration() {
    config.bundles.forEach(hydrateBundle);
  }
  function scheduleHydration() {
    if ('requestIdleCallback' in window) {
      requestIdleCallback(startHydration, { timeout: 1500 });
    } else {
      setTimeout(startHydration, 100);
    }
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', scheduleHydration);
  } else {
    scheduleHydration();
  }
})();
</script>
{%- endif -%}

