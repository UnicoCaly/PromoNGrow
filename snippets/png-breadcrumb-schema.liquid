{%- comment -%}
  BreadcrumbList JSON-LD for AEO/GEO.
  Auto-generates breadcrumb based on page_type (product, collection, article, page).
  Render this snippet in templates that have a breadcrumb HTML element.

  Usage:
    {% render 'png-breadcrumb-schema' %}
{%- endcomment -%}

{%- liquid
  assign breadcrumb_items = ''
  assign origin = request.origin
-%}

{%- case request.page_type -%}
  {%- when 'product' -%}
    {%- if collection != blank -%}
      {%- capture breadcrumb_items -%}
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ origin }}" },
        { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ origin }}/collections/{{ collection.handle }}" },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": "{{ origin }}{{ product.url }}" }
      {%- endcapture -%}
    {%- else -%}
      {%- capture breadcrumb_items -%}
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ origin }}" },
        { "@type": "ListItem", "position": 2, "name": "Products", "item": "{{ origin }}/collections/all" },
        { "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": "{{ origin }}{{ product.url }}" }
      {%- endcapture -%}
    {%- endif -%}

  {%- when 'collection' -%}
    {%- capture breadcrumb_items -%}
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ origin }}" },
      { "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": "{{ origin }}/collections/{{ collection.handle }}" }
    {%- endcapture -%}

  {%- when 'article' -%}
    {%- capture breadcrumb_items -%}
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ origin }}" },
      { "@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": "{{ origin }}/blogs/{{ blog.handle }}" },
      { "@type": "ListItem", "position": 3, "name": {{ article.title | json }}, "item": "{{ origin }}{{ article.url }}" }
    {%- endcapture -%}

  {%- when 'page' -%}
    {%- capture breadcrumb_items -%}
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "{{ origin }}" },
      { "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": "{{ origin }}/pages/{{ page.handle }}" }
    {%- endcapture -%}
{%- endcase -%}

{%- if breadcrumb_items != blank -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {{ breadcrumb_items }}
  ]
}
</script>
{%- endif -%}
