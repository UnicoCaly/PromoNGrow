<!-- Promo & Grow: PDP Process Ribbon (War-Room steal: Packeze 4-step) -->
{%- comment -%}
  Compact buy -> design -> approve -> deliver reassurance ribbon for the
  product page. Renders right after the buy buttons so a hesitating
  high-ticket buyer sees exactly what happens after they commit.
  Reuses the design-system step circles; copper-accents the final step.
{%- endcomment -%}
<div class="png-process-ribbon" aria-label="How your order works">
  <div class="png-process-ribbon__step">
    <span class="png-process-ribbon__num">1</span>
    <span class="png-process-ribbon__label">Start your order</span>
  </div>
  <span class="png-process-ribbon__arrow" aria-hidden="true">&rarr;</span>
  <div class="png-process-ribbon__step">
    <span class="png-process-ribbon__num">2</span>
    <span class="png-process-ribbon__label">Send your logo</span>
  </div>
  <span class="png-process-ribbon__arrow" aria-hidden="true">&rarr;</span>
  <div class="png-process-ribbon__step">
    <span class="png-process-ribbon__num">3</span>
    <span class="png-process-ribbon__label">Approve free proof</span>
  </div>
  <span class="png-process-ribbon__arrow" aria-hidden="true">&rarr;</span>
  <div class="png-process-ribbon__step">
    <span class="png-process-ribbon__num png-process-ribbon__num--accent">4</span>
    <span class="png-process-ribbon__label">Delivered in 5 days</span>
  </div>
</div>
