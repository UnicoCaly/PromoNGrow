{%- comment -%}
  Promo & Grow — How It Works 3-step strip (for PDPs)

  Renders the 3-step concierge journey to remove uncertainty for first-time custom buyers.

  Usage (PDP — render once below the buy box):
    {%- render 'png-how-it-works' -%}
{%- endcomment -%}

<section class="png-how-it-works" aria-label="How it works">
  <div class="png-how-it-works__inner">
    <h2 class="png-how-it-works__title">How it works</h2>
    <ol class="png-how-it-works__steps">
      <li class="png-how-it-works__step">
        <span class="png-how-it-works__num">1</span>
        <div class="png-how-it-works__copy">
          <p class="png-how-it-works__step-title">Send your logo</p>
          <p class="png-how-it-works__step-body">Upload your file or share a link. Drop your event date too — we plan around it.</p>
        </div>
      </li>
      <li class="png-how-it-works__step">
        <span class="png-how-it-works__num">2</span>
        <div class="png-how-it-works__copy">
          <p class="png-how-it-works__step-title">Approve your free proof</p>
          <p class="png-how-it-works__step-body">We send a digital proof. Nothing prints until you approve it — no charge, no commitment.</p>
        </div>
      </li>
      <li class="png-how-it-works__step">
        <span class="png-how-it-works__num png-how-it-works__num--accent">3</span>
        <div class="png-how-it-works__copy">
          <p class="png-how-it-works__step-title">Delivered in 5 business days</p>
          <p class="png-how-it-works__step-body">Production starts the day you approve. Shipped nationwide, on time.</p>
        </div>
      </li>
    </ol>
  </div>
</section>

<style>
  .png-how-it-works {
    background: #F7F7F5;
    padding: 4rem 2rem;
    margin: 4rem 0 0;
    border-radius: 10px;
    font-family: 'DM Sans', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  .png-how-it-works__inner {
    max-width: 1100px;
    margin: 0 auto;
  }

  .png-how-it-works__title {
    font-family: 'DM Serif Display', Georgia, serif;
    font-weight: 400;
    font-size: 2.4rem;
    color: #1B2838;
    text-align: center;
    margin: 0 0 3rem;
    line-height: 1.2;
  }

  .png-how-it-works__steps {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.4rem;
  }

  .png-how-it-works__step {
    display: flex;
    align-items: flex-start;
    gap: 1.4rem;
  }

  .png-how-it-works__num {
    flex: 0 0 36px;
    width: 36px;
    height: 36px;
    border: 1.5px solid #1B2838;
    border-radius: 50%;
    color: #1B2838;
    font-family: 'DM Serif Display', Georgia, serif;
    font-weight: 400;
    font-size: 1.6rem;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .png-how-it-works__num--accent {
    background: #C17A3A;
    border-color: #C17A3A;
    color: #FFFFFF;
  }

  .png-how-it-works__copy {
    flex: 1 1 auto;
  }

  .png-how-it-works__step-title {
    font-family: 'DM Sans', sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: #1B2838;
    margin: 0 0 0.4rem;
    line-height: 1.3;
  }

  .png-how-it-works__step-body {
    font-size: 1.3rem;
    line-height: 1.6;
    color: #495057;
    margin: 0;
  }

  @media (max-width: 749px) {
    .png-how-it-works {
      padding: 3rem 1.6rem;
      margin: 3rem 0 0;
      border-radius: 8px;
    }

    .png-how-it-works__steps {
      grid-template-columns: 1fr;
      gap: 1.8rem;
    }

    .png-how-it-works__title {
      font-size: 2rem;
      margin-bottom: 2rem;
    }
  }
</style>
